          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load plans. Please try again."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los planes. Por favor inténtalo de nuevo."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les plans. Veuillez réessayer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les plans. Veuillez réessayer."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્લાન લોડ કરી શકાયા નથી. કૃપા કરીને ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לטעון תוכניות. אנא נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "योजनाएं लोड नहीं की जा सकीं. कृपया पुन: प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće učitati planove. Molimo pokušajte ponovo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuat rencana. Silakan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i piani. Per favore riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計画を読み込めませんでした。もう一度試してください。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯೋಜನೆಗಳನ್ನು ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획을 로드할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്ലാനുകൾ ലോഡ് ചെയ്യാനായില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "योजना लोड करू शकलो नाही. कृपया पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuatkan rancangan. Sila cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste inn planer. Vennligst prøv igjen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan plannen niet laden. Probeer het opnieuw."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯୋଜନାଗୁଡିକ ଲୋଡ୍ ହୋଇପାରିଲା ନାହିଁ | ଦୟାକରି ପୁନର୍ବାର ଚେଷ୍ଟା କରନ୍ତୁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਯੋਜਨਾਵਾਂ ਨੂੰ ਲੋਡ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਿਆ। ਕਿਰਪਾ ਕਰਕੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os planos. Por favor, tente novamente."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டங்களை ஏற்ற முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్లాన్‌లను లోడ్ చేయడం సాధ్యపడలేదు. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถโหลดแผนได้ โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlar yüklenemedi. Lütfen tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити плани. Спробуйте ще раз."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "پلانز لوڈ نہیں ہو سکے۔ براہ کرم دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải kế hoạch. Vui lòng thử lại."
          }
        },
        "zh-Hans": {

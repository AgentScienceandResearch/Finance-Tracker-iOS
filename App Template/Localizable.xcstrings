        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಪ್ಲಿಕೇಶನ್‌ನಾದ್ಯಂತ ವಹಿವಾಟುಗಳು, ಬಜೆಟ್‌ಗಳು, ಆದಾಯ ಮತ್ತು ಮರುಕಳಿಸುವ ಬಿಲ್‌ಗಳನ್ನು ರಚಿಸಿ ಅಥವಾ ಎಡಿಟ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전체에서 거래, 예산, 수입, 반복 청구서를 생성하거나 편집하세요."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പിലുടനീളം ഇടപാടുകൾ, ബജറ്റുകൾ, വരുമാനം, ആവർത്തിച്ചുള്ള ബില്ലുകൾ എന്നിവ സൃഷ്‌ടിക്കുക അല്ലെങ്കിൽ എഡിറ്റ് ചെയ്യുക."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "संपूर्ण ॲपवर व्यवहार, बजेट, उत्पन्न आणि आवर्ती बिले तयार करा किंवा संपादित करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat atau edit urus niaga, belanjawan, pendapatan dan bil berulang merentas apl."
          }

    "Turn everyday requests into real progress. Ask, review, and move your money forward.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويل الطلبات اليومية إلى تقدم حقيقي. اسأل وراجع وحرك أموالك للأمام."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "দৈনন্দিন অনুরোধগুলিকে বাস্তব অগ্রগতিতে পরিণত করুন। জিজ্ঞাসা করুন, পর্যালোচনা করুন এবং আপনার অর্থ এগিয়ে নিয়ে যান।"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwandeln Sie alltägliche Wünsche in echte Fortschritte. Fragen Sie, überprüfen Sie und übertragen Sie Ihr Geld."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn everyday requests into real progress. Ask, review, and move your money forward."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn everyday requests into real progress. Ask, review, and move your money forward."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn everyday requests into real progress. Ask, review, and move your money forward."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn everyday requests into real progress. Ask, review, and move your money forward."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierta las solicitudes cotidianas en un progreso real. Pregunte, revise y haga avanzar su dinero."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez les demandes quotidiennes en réels progrès. Demandez, examinez et faites avancer votre argent."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez les demandes quotidiennes en réels progrès. Demandez, examinez et faites avancer votre argent."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "રોજિંદા વિનંતીઓને વાસ્તવિક પ્રગતિમાં ફેરવો. પૂછો, સમીક્ષા કરો અને તમારા પૈસા આગળ ખસેડો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפוך בקשות יומיומיות להתקדמות אמיתית. שאל, בדוק והצע את הכסף שלך קדימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोजमर्रा के अनुरोधों को वास्तविक प्रगति में बदलें। पूछें, समीक्षा करें और अपना पैसा आगे बढ़ाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretvorite svakodnevne zahtjeve u pravi napredak. Pitajte, pregledajte i pomaknite svoj novac naprijed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah permintaan sehari-hari menjadi kemajuan nyata. Tanyakan, tinjau, dan gerakkan uang Anda ke depan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma le richieste quotidiane in progressi reali. Chiedi, esamina e sposta i tuoi soldi in avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日々のリクエストを実際の進歩に変えましょう。質問し、検討し、資金を前進させましょう。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ದೈನಂದಿನ ವಿನಂತಿಗಳನ್ನು ನಿಜವಾದ ಪ್ರಗತಿಗೆ ತಿರುಗಿಸಿ. ಕೇಳಿ, ಪರಿಶೀಲಿಸಿ ಮತ್ತು ನಿಮ್ಮ ಹಣವನ್ನು ಮುಂದಕ್ಕೆ ಸರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일상적인 요청을 실제 진행 상황으로 전환하세요. 질문하고, 검토하고, 돈을 앞으로 옮기십시오."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ദൈനംദിന അഭ്യർത്ഥനകൾ യഥാർത്ഥ പുരോഗതിയിലേക്ക് മാറ്റുക. ചോദിക്കുക, അവലോകനം ചെയ്യുക, നിങ്ങളുടെ പണം മുന്നോട്ട് നീക്കുക."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "दररोजच्या विनंत्यांना वास्तविक प्रगतीमध्ये बदला. विचारा, पुनरावलोकन करा आणि तुमचे पैसे पुढे हलवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar permintaan setiap hari menjadi kemajuan sebenar. Tanya, semak dan gerakkan wang anda ke hadapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør daglige forespørsler til virkelig fremgang. Spør, se gjennom og flytt pengene dine fremover."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet alledaagse verzoeken om in echte vooruitgang. Vraag, bekijk en maak uw geld beschikbaar."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦ day ନନ୍ଦିନ ଅନୁରୋଧକୁ ପ୍ରକୃତ ପ୍ରଗତିରେ ପରିଣତ କରନ୍ତୁ | ପଚାର, ସମୀକ୍ଷା ଏବଂ ତୁମର ଟଙ୍କାକୁ ଆଗକୁ ବ move ାନ୍ତୁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੋਜ਼ਾਨਾ ਬੇਨਤੀਆਂ ਨੂੰ ਅਸਲ ਤਰੱਕੀ ਵਿੱਚ ਬਦਲੋ। ਪੁੱਛੋ, ਸਮੀਖਿਆ ਕਰੋ ਅਤੇ ਆਪਣੇ ਪੈਸੇ ਨੂੰ ਅੱਗੇ ਭੇਜੋ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme as solicitações diárias em progresso real. Pergunte, analise e transfira seu dinheiro."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "அன்றாட கோரிக்கைகளை உண்மையான முன்னேற்றமாக மாற்றவும். கேட்கவும், மதிப்பாய்வு செய்யவும் மற்றும் உங்கள் பணத்தை முன்னோக்கி நகர்த்தவும்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "రోజువారీ అభ్యర్థనలను నిజమైన పురోగతిగా మార్చండి. అడగండి, సమీక్షించండి మరియు మీ డబ్బును ముందుకు తరలించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนคำขอในแต่ละวันให้เป็นความก้าวหน้าอย่างแท้จริง สอบถาม ตรวจสอบ และโอนเงินของคุณไปข้างหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük istekleri gerçek ilerlemeye dönüştürün. Paranızı sorun, inceleyin ve ileriye taşıyın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетворіть щоденні запити на реальний прогрес. Запитуйте, переглядайте та спрямовуйте свої гроші вперед."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "روزمرہ کی درخواستوں کو حقیقی ترقی میں تبدیل کریں۔ پوچھیں، جائزہ لیں اور اپنے پیسے کو آگے بڑھائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến những yêu cầu hàng ngày thành tiến bộ thực sự. Hỏi, xem xét và chuyển tiền của bạn về phía trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将日常请求转化为真正的进步。询问、审查并转移您的资金。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將日常請求轉化為真正的進步。詢問、審查並轉移您的資金。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør daglige forespørsler til virkelig fremgang. Spør, se gjennom og flytt pengene dine fremover."
          }
        }
      }
    },

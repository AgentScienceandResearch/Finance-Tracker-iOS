    "Try a clearer image or one that shows financial data more clearly.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب صورة أكثر وضوحًا أو صورة تعرض البيانات المالية بشكل أكثر وضوحًا."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি পরিষ্কার চিত্র বা এমন একটি চেষ্টা করুন যা আর্থিক ডেটা আরও স্পষ্টভাবে দেখায়।"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es mit einem klareren Bild oder einem Bild, das Finanzdaten deutlicher zeigt."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a clearer image or one that shows financial data more clearly."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a clearer image or one that shows financial data more clearly."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a clearer image or one that shows financial data more clearly."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a clearer image or one that shows financial data more clearly."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruebe con una imagen más clara o una que muestre los datos financieros con mayor claridad."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez une image plus claire ou une image qui montre les données financières plus clairement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez une image plus claire ou une image qui montre les données financières plus clairement."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "વધુ સ્પષ્ટ રીતે નાણાકીય ડેટા દર્શાવતી સ્પષ્ટ છબી અથવા એક અજમાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסה תמונה ברורה יותר או תמונה שמציגה נתונים פיננסיים בצורה ברורה יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्पष्ट छवि या ऐसी छवि आज़माएं जो वित्तीय डेटा को अधिक स्पष्ट रूप से दिखाए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušajte s jasnijom slikom ili onom koja jasnije prikazuje financijske podatke."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Usahakan gambar yang lebih jelas atau yang menampilkan data keuangan dengan lebih jelas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un'immagine più chiara o una che mostri i dati finanziari in modo più chiaro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より鮮明な画像、または財務データをより明確に示す画像を試してください。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಪಷ್ಟವಾದ ಚಿತ್ರ ಅಥವಾ ಹಣಕಾಸಿನ ಡೇಟಾವನ್ನು ಹೆಚ್ಚು ಸ್ಪಷ್ಟವಾಗಿ ತೋರಿಸುವ ಒಂದನ್ನು ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 선명한 이미지나 재무 데이터를 더 명확하게 보여주는 이미지를 사용해 보세요."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "വ്യക്തമായ ഒരു ചിത്രം അല്ലെങ്കിൽ സാമ്പത്തിക ഡാറ്റ കൂടുതൽ വ്യക്തമായി കാണിക്കുന്ന ഒന്ന് പരീക്ഷിക്കുക."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्पष्ट प्रतिमा किंवा आर्थिक डेटा अधिक स्पष्टपणे दर्शविणारी एक वापरून पहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba imej yang lebih jelas atau yang menunjukkan data kewangan dengan lebih jelas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv et klarere bilde eller et som viser økonomiske data tydeligere."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer een duidelijkere afbeelding of een afbeelding die financiële gegevens duidelijker weergeeft."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ସ୍ୱଚ୍ଛ ପ୍ରତିଛବି ଚେଷ୍ଟା କରନ୍ତୁ କିମ୍ବା ଆର୍ଥିକ ତଥ୍ୟକୁ ଅଧିକ ସ୍ପଷ୍ଟ ଭାବରେ ଦର୍ଶାଉଛି |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਸਪਸ਼ਟ ਚਿੱਤਰ ਜਾਂ ਇੱਕ ਅਜਿਹਾ ਚਿੱਤਰ ਅਜ਼ਮਾਓ ਜੋ ਵਿੱਤੀ ਡੇਟਾ ਨੂੰ ਵਧੇਰੇ ਸਪਸ਼ਟ ਰੂਪ ਵਿੱਚ ਦਿਖਾਉਂਦਾ ਹੈ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente uma imagem mais clara ou que mostre os dados financeiros com mais clareza."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "தெளிவான படத்தை அல்லது நிதித் தரவை இன்னும் தெளிவாகக் காட்டும் படத்தை முயற்சிக்கவும்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "స్పష్టమైన చిత్రాన్ని లేదా ఆర్థిక డేటాను మరింత స్పష్టంగా చూపే చిత్రాన్ని ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองใช้รูปภาพที่ชัดเจนกว่านี้หรือรูปภาพที่แสดงข้อมูลทางการเงินได้ชัดเจนยิ่งขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha net bir resim veya finansal verileri daha net gösteren bir resim deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте чіткіше зображення або таке, яке чіткіше відображає фінансові дані."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک واضح تصویر یا ایک ایسی تصویر آزمائیں جو مالیاتی ڈیٹا کو زیادہ واضح طور پر دکھائے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử một hình ảnh rõ ràng hơn hoặc một hình ảnh hiển thị dữ liệu tài chính rõ ràng hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试使用更清晰的图像或更清晰地显示财务数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試使用更清晰的圖像或更清晰地顯示財務數據。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv et klarere bilde eller et som viser økonomiske data tydeligere."

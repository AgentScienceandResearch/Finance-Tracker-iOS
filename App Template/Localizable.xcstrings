            "value": "\nआवेदन नहीं किया जा सका:\n"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nNije moguće primijeniti:\n"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\nTidak dapat melamar:\n"
          }
        },
        "it": {
          "stringUnit": {

        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முதல் செலவைச் சேர்க்க + என்பதைத் தட்டவும்"
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ మొదటి ఖర్చును జోడించడానికి + నొక్కండి"

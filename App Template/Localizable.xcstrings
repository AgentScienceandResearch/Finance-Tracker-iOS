        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು ವಿನಂತಿಸಿದ ಬದಲಾವಣೆಗಳನ್ನು ಸಿದ್ಧಪಡಿಸಿದೆ. ಅನ್ವಯಿಸುವ ಮೊದಲು ಅವುಗಳನ್ನು ಕೆಳಗೆ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청하신 변경 사항을 준비했습니다. 신청하기 전에 아래 내용을 검토하세요."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ആവശ്യപ്പെട്ട മാറ്റങ്ങൾ ഞാൻ തയ്യാറാക്കി. അപേക്ഷിക്കുന്നതിന് മുമ്പ് അവ ചുവടെ അവലോകനം ചെയ്യുക."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "मी विनंती केलेले बदल तयार केले. अर्ज करण्यापूर्वी खाली त्यांचे पुनरावलोकन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya menyediakan perubahan yang diminta. Semak mereka di bawah sebelum memohon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forberedte de forespurte endringene. Se gjennom dem nedenfor før du søker."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb de gevraagde wijzigingen voorbereid. Bekijk ze hieronder voordat u zich aanmeldt."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ମୁଁ ଅନୁରୋଧ କରାଯାଇଥିବା ପରିବର୍ତ୍ତନଗୁଡିକ ପ୍ରସ୍ତୁତ କଲି | ଆବେଦନ କରିବା ପୂର୍ବରୁ ସେମାନଙ୍କୁ ନିମ୍ନରେ ସମୀକ୍ଷା କରନ୍ତୁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਂ ਬੇਨਤੀ ਕੀਤੀਆਂ ਤਬਦੀਲੀਆਂ ਤਿਆਰ ਕੀਤੀਆਂ। ਅਰਜ਼ੀ ਦੇਣ ਤੋਂ ਪਹਿਲਾਂ ਹੇਠਾਂ ਉਹਨਾਂ ਦੀ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparei as alterações solicitadas. Revise-os abaixo antes de se inscrever."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "கோரப்பட்ட மாற்றங்களை நான் தயார் செய்தேன். விண்ணப்பிக்கும் முன் அவற்றை கீழே மதிப்பாய்வு செய்யவும்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను అభ్యర్థించిన మార్పులను సిద్ధం చేసాను. దరఖాస్తు చేయడానికి ముందు వాటిని క్రింద సమీక్షించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันเตรียมการเปลี่ยนแปลงที่ร้องขอแล้ว ตรวจสอบด้านล่างก่อนสมัคร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstenilen değişiklikleri hazırladım. Başvuru yapmadan önce bunları aşağıda inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я підготував потрібні зміни. Перегляньте їх нижче, перш ніж подавати заявку."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "میں نے مطلوبہ تبدیلیاں تیار کیں۔ درخواست دینے سے پہلے ذیل میں ان کا جائزہ لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã chuẩn bị những thay đổi được yêu cầu. Hãy xem xét chúng dưới đây trước khi áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我准备了所要求的更改。申请前请先查看以下内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我準備了所要求的更改。申請前請先查看以下內容。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forberedte de forespurte endringene. Se gjennom dem nedenfor før du søker."
          }
        }
      }
    },

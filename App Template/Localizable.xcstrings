        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Su gasto máximo este mes es %1$@ a %2$@. ¿Quieres establecer un presupuesto de categoría? 💬"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos principales dépenses ce mois-ci sont de %1$@ à %2$@. Vous souhaitez définir un budget de catégorie ? 💬"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos principales dépenses ce mois-ci sont de %1$@ à %2$@. Vous souhaitez définir un budget de catégorie ? 💬"
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "આ મહિને તમારો સૌથી વધુ ખર્ચ %2$@ પર %1$@ છે. શ્રેણી બજેટ સેટ કરવા માંગો છો? 💬"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההוצאה הגבוהה ביותר שלך החודש היא %1$@ ב-%2$@. רוצה להגדיר תקציב קטגוריה? 💬"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस महीने आपका अधिकतम खर्च %1$@ %2$@ पर है। क्या आप एक श्रेणी बजट निर्धारित करना चाहते हैं? 💬"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša najveća potrošnja ovog mjeseca je %1$@ na %2$@. Želite li postaviti proračun kategorije? 💬"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelanjaan tertinggi Anda bulan ini adalah %1$@ pada %2$@. Ingin menetapkan anggaran kategori? 💬"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua spesa massima questo mese è %1$@ presso %2$@. Vuoi impostare un budget per la categoria? 💬"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の最高支出は %1$@、%2$@ です。カテゴリの予算を設定したいですか? 💬"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ತಿಂಗಳ ನಿಮ್ಮ ಹೆಚ್ಚಿನ ಖರ್ಚು %2$@ ನಲ್ಲಿ %1$@ ಆಗಿದೆ. ವರ್ಗದ ಬಜೆಟ್ ಅನ್ನು ಹೊಂದಿಸಲು ಬಯಸುವಿರಾ? 💬"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 최대 지출액은 %2$@에 %1$@입니다. 카테고리 예산을 설정하고 싶으십니까? 💬"
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ മാസം നിങ്ങൾ ഏറ്റവും കൂടുതൽ ചെലവഴിക്കുന്നത് %2$@-ന് %1$@ ആണ്. ഒരു വിഭാഗം ബജറ്റ് സജ്ജീകരിക്കണോ? 💬"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "या महिन्यात तुमचा सर्वाधिक खर्च %2$@ वाजता %1$@ आहे. श्रेणी बजेट सेट करू इच्छिता? 💬"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbelanjaan teratas anda bulan ini ialah %1$@ pada %2$@. Ingin menetapkan bajet kategori? 💬"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Toppforbruket ditt denne måneden er %1$@ på %2$@. Vil du angi et kategoribudsjett? 💬"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw hoogste uitgaven deze maand bedragen %1$@ en %2$@. Wilt u een categoriebudget instellen? 💬"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ମାସରେ ଆପଣଙ୍କର ସର୍ବୋଚ୍ଚ ଖର୍ଚ୍ଚ ହେଉଛି %1$@ %2$@ ରେ | ଏକ ବର୍ଗ ବଜେଟ୍ ସେଟ୍ କରିବାକୁ ଚାହୁଁଛନ୍ତି କି? 💬"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਮਹੀਨੇ ਤੁਹਾਡਾ ਸਭ ਤੋਂ ਵੱਧ ਖਰਚ %2$@ 'ਤੇ %1$@ ਹੈ। ਇੱਕ ਸ਼੍ਰੇਣੀ ਦਾ ਬਜਟ ਸੈੱਟ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ? 💬"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu maior gasto neste mês é %1$@ em %2$@. Quer definir um orçamento de categoria? 💬"
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மாதம் %2$@க்கு %1$@ ஆகும். வகை பட்ஜெட்டை அமைக்க வேண்டுமா? 💬"
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ నెలలో మీరు అత్యధికంగా ఖర్చు చేయడం %2$@ వద్ద %1$@. కేటగిరీ బడ్జెట్‌ను సెట్ చేయాలనుకుంటున్నారా? 💬"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้จ่ายสูงสุดของคุณในเดือนนี้คือ %1$@ ที่ %2$@ ต้องการตั้งค่างบประมาณหมวดหมู่หรือไม่? 😢"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayki en yüksek harcamanız %1$@, %2$@. Bir kategori bütçesi mi ayarlamak istiyorsunuz? 💬"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші максимальні витрати цього місяця становлять %1$@ у %2$@. Хочете встановити бюджет категорії? 💬"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "اس مہینے میں آپ کا سب سے زیادہ خرچ %2$@ پر %1$@ ہے۔ زمرہ کا بجٹ مقرر کرنا چاہتے ہیں؟ 💬"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức chi tiêu nhiều nhất của bạn trong tháng này là %1$@ ở mức %2$@. Bạn muốn đặt ngân sách danh mục? 💬"
          }

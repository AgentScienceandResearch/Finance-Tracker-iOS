          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengesahan gagal. Sila cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentisering mislyktes. Vennligst prøv igjen."

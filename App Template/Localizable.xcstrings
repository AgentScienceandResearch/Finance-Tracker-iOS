        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ ಚಿತ್ರವನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ ಹಸ್ತಚಾಲಿತವಾಗಿ ವೆಚ್ಚವನ್ನು ಸೇರಿಸಿ."

        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରାମାଣିକିକରଣ ବିଫଳ ହେଲା | ଦୟାକରି ପୁନର୍ବାର ଚେଷ୍ଟା କରନ୍ତୁ |"

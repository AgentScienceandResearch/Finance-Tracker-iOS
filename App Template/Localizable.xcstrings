        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur réseau. Vérifiez votre connexion."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "નેટવર્ક ભૂલ. તમારું કનેક્શન તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שגיאת רשת. בדוק את החיבור שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क त्रुटि. अपना कनेक्शन जांचें."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mrežna greška. Provjerite vezu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesalahan jaringan. Periksa koneksi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore di rete. Controlla la tua connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークエラー。接続を確認してください。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೆಟ್‌ವರ್ಕ್ ದೋಷ. ನಿಮ್ಮ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 오류입니다. 연결을 확인하세요."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "നെറ്റ്‌വർക്ക് പിശക്. നിങ്ങളുടെ കണക്ഷൻ പരിശോധിക്കുക."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क त्रुटी. तुमचे कनेक्शन तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ralat rangkaian. Semak sambungan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettverksfeil. Sjekk tilkoblingen din."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerkfout. Controleer uw verbinding."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ନେଟୱର୍କ ତ୍ରୁଟି | ଆପଣଙ୍କର ସଂଯୋଗ ଯାଞ୍ଚ କରନ୍ତୁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੈੱਟਵਰਕ ਗੜਬੜ। ਆਪਣੇ ਕਨੈਕਸ਼ਨ ਦੀ ਜਾਂਚ ਕਰੋ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro de rede. Verifique sua conexão."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "நெட்வொர்க் பிழை. உங்கள் இணைப்பைச் சரிபார்க்கவும்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "నెట్‌వర్క్ లోపం. మీ కనెక్షన్‌ని తనిఖీ చేయండి."

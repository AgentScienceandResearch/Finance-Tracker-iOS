    "AI will extract all transactions\nfrom bank statements, receipts,\nor expense screenshots.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يقوم الذكاء الاصطناعي باستخراج جميع المعاملات\nمن بيانات البنك، والإيصالات،\nأو لقطات الشاشة للنفقات."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "AI সমস্ত লেনদেন বের করবে\nব্যাঙ্ক স্টেটমেন্ট, রসিদ থেকে,\nঅথবা খরচের স্ক্রিনশট।"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "KI extrahiert alle Transaktionen\naus Kontoauszügen, Quittungen,\noder Spesen-Screenshots."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "AI will extract all transactions\nfrom bank statements, receipts,\nor expense screenshots."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "AI will extract all transactions\nfrom bank statements, receipts,\nor expense screenshots."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "AI will extract all transactions\nfrom bank statements, receipts,\nor expense screenshots."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "AI will extract all transactions\nfrom bank statements, receipts,\nor expense screenshots."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA extraerá todas las transacciones\nde extractos bancarios, recibos,\no capturas de pantalla de gastos."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA extraira toutes les transactions\nà partir des relevés bancaires, des reçus,\nou des captures d'écran de dépenses."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA extraira toutes les transactions\nà partir des relevés bancaires, des reçus,\nou des captures d'écran de dépenses."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "AI તમામ વ્યવહારો બહાર કાઢશે\nબેંક સ્ટેટમેન્ટ, રસીદોમાંથી,\nઅથવા ખર્ચના સ્ક્રીનશૉટ્સ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "AI יחלץ את כל העסקאות\nמדפי בנק, קבלות,\nאו צילומי מסך של הוצאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एआई सभी लेनदेन निकालेगा\nबैंक स्टेटमेंट, रसीदों से,\nया व्यय स्क्रीनशॉट."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI će izdvojiti sve transakcije\niz bankovnih izvoda, potvrda,\nili snimke zaslona troškova."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI akan mengekstrak semua transaksi\ndari laporan bank, kwitansi,\natau tangkapan layar pengeluaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intelligenza artificiale estrarrà tutte le transazioni\nda estratti conto, ricevute,\no screenshot delle spese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIがすべてのトランザクションを抽出します\n銀行取引明細書、領収書、\nまたは経費のスクリーンショット。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ಎಲ್ಲಾ ವಹಿವಾಟುಗಳನ್ನು ಹೊರತೆಗೆಯುತ್ತದೆ\nಬ್ಯಾಂಕ್ ಹೇಳಿಕೆಗಳು, ರಸೀದಿಗಳಿಂದ,\nಅಥವಾ ಖರ್ಚು ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ಗಳು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 모든 거래를 추출합니다.\n은행 명세서, 영수증,\n또는 비용 스크린샷."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "AI എല്ലാ ഇടപാടുകളും എക്‌സ്‌ട്രാക്‌റ്റ് ചെയ്യും\nബാങ്ക് സ്റ്റേറ്റ്‌മെൻ്റുകൾ, രസീതുകൾ,\nഅല്ലെങ്കിൽ ചെലവ് സ്ക്രീൻഷോട്ടുകൾ."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "AI सर्व व्यवहार काढेल\nबँक स्टेटमेंट्स, पावत्या,\nकिंवा खर्चाचे स्क्रीनशॉट."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "AI akan mengeluarkan semua transaksi\ndaripada penyata bank, resit,\natau tangkapan skrin perbelanjaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI vil trekke ut alle transaksjoner\nfra kontoutskrifter, kvitteringer,\neller utgiftsskjermbilder."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "AI zal alle transacties extraheren\nuit bankafschriften, kwitanties,\nof onkostenscreenshots."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ସମସ୍ତ କାରବାର ବାହାର କରିବ |\nବ୍ୟାଙ୍କ ଷ୍ଟେଟମେଣ୍ଟ, ରସିଦ,\nକିମ୍ବା ସ୍କ୍ରିନସଟ୍ ଖର୍ଚ୍ଚ କରନ୍ତୁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ਸਾਰੇ ਲੈਣ-ਦੇਣ ਨੂੰ ਐਕਸਟਰੈਕਟ ਕਰੇਗਾ\nਬੈਂਕ ਸਟੇਟਮੈਂਟਾਂ, ਰਸੀਦਾਂ ਤੋਂ,\nਜਾਂ ਖਰਚੇ ਦੇ ਸਕ੍ਰੀਨਸ਼ਾਟ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AI extrairá todas as transações\nde extratos bancários, recibos,\nou capturas de tela de despesas."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "AI அனைத்து பரிவர்த்தனைகளையும் பிரித்தெடுக்கும்\nவங்கி அறிக்கைகள், ரசீதுகள்,\nஅல்லது செலவு திரைக்காட்சிகள்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "AI అన్ని లావాదేవీలను సంగ్రహిస్తుంది\nబ్యాంక్ స్టేట్‌మెంట్‌లు, రసీదులు,\nలేదా ఖర్చు స్క్రీన్‌షాట్‌లు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AI จะแยกธุรกรรมทั้งหมด\nจากใบแจ้งยอดธนาคาร ใบเสร็จรับเงิน\nหรือภาพหน้าจอค่าใช้จ่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka tüm işlemleri çıkaracak\nbanka ekstrelerinden, makbuzlardan,\nveya gider ekran görüntüleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI витягне всі транзакції\nз банківських виписок, квитанцій,\nабо скріншоти витрат."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "AI تمام لین دین کو نکالے گا۔\nبینک اسٹیٹمنٹس، رسیدوں سے،\nیا اخراجات کے اسکرین شاٹس۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI sẽ trích xuất tất cả các giao dịch\ntừ báo cáo ngân hàng, biên lai,\nhoặc ảnh chụp màn hình chi phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI将提取所有交易\n从银行对账单、收据、\n或费用截图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI將提取所有交易\n從銀行對帳單、收據、\n或費用截圖。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "AI vil trekke ut alle transaksjoner\nfra kontoutskrifter, kvitteringer,\neller utgiftsskjermbilder."
          }
        }
      }
    },

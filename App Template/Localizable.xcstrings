          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ഫീച്ചറുകളും, നിങ്ങളുടെ ട്രയൽ അവസാനിക്കുന്നത് വരെ പൂജ്യം ചാർജ്."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक वैशिष्ट्य, तुमची चाचणी संपेपर्यंत शून्य शुल्क."

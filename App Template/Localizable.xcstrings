        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer opnieuw te scannen met betere belichting of een vlakker document."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଉତ୍ତମ ଆଲୋକ କିମ୍ବା ଏକ ଚାଟୁକାର ଡକ୍ୟୁମେଣ୍ଟ ସହିତ ପୁନର୍ବାର ସ୍କାନ କରିବାକୁ ଚେଷ୍ଟା କରନ୍ତୁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਿਹਤਰ ਰੋਸ਼ਨੀ ਜਾਂ ਚਾਪਲੂਸੀ ਦਸਤਾਵੇਜ਼ ਨਾਲ ਦੁਬਾਰਾ ਸਕੈਨ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"

    "By subscribing you agree to our": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "بالاشتراك فإنك توافق على لدينا"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবস্ক্রাইব করে আপনি আমাদের সাথে সম্মত হন"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Ihrer Anmeldung stimmen Sie unserem zu"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "By subscribing you agree to our"
          }
        },

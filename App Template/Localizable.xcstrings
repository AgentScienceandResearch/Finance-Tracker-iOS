    "You spent %@ on %@ this month, which is %lld%% of total spending.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أنفقت %1$@ على %2$@ هذا الشهر، وهو ما يعادل %3$lld%% من إجمالي الإنفاق."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এই মাসে %2$@ এ %1$@ ব্যয় করেছেন, যা মোট ব্যয়ের %3$lld%%।"
          }
        },
        "de-DE": {

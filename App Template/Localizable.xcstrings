            "state": "translated",
            "value": "חינם עבור %1$@, ולאחר מכן %2$@/%3$@. בטל בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ के लिए निःशुल्क, फिर %2$@/%3$@। किसी भी समय रद्द करें."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besplatno %1$@, a zatim %2$@/%3$@. Otkaži bilo kada."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis untuk %1$@, lalu %2$@/%3$@. Batalkan kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per %1$@, poi %2$@/%3$@. Annulla in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は無料、その後は %2$@/%3$@ です。いつでもキャンセルできます。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ಗೆ ಉಚಿತ, ನಂತರ %2$@/%3$@. ಯಾವಾಗ ಬೇಕಾದರೂ ರದ್ದುಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 동안은 무료이고 그 이후에는 %2$@/%3$@입니다. 언제든지 취소하세요."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ എന്നതിന് സൗജന്യം, തുടർന്ന് %2$@/%3$@. എപ്പോൾ വേണമെങ്കിലും റദ്ദാക്കുക."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ साठी विनामूल्य, नंतर %2$@/%3$@. कधीही रद्द करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percuma untuk %1$@, kemudian %2$@/%3$@. Batalkan bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis for %1$@, deretter %2$@/%3$@. Avbryt når som helst."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis voor %1$@, daarna %2$@/%3$@. Annuleer op elk gewenst moment."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ପାଇଁ ମାଗଣା, ତାପରେ %2$@/%3$@। ଯେକୌଣସି ସମୟରେ ବାତିଲ କରନ୍ତୁ।"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ਲਈ ਮੁਫ਼ਤ, ਫਿਰ %2$@/%3$@। ਕਿਸੇ ਵੀ ਸਮੇਂ ਰੱਦ ਕਰੋ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuito para %1$@ e depois %2$@/%3$@. Cancele a qualquer momento."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@க்கு இலவசம், பிறகு %2$@/%3$@. எப்போது வேண்டுமானாலும் ரத்து செய்யலாம்."
          }
        },
        "te-IN": {
          "stringUnit": {

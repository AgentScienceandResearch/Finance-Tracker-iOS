        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪೂರ್ಣ ಪ್ರವೇಶ, ಪ್ರತಿ ತಿಂಗಳು ಬಿಲ್ ಮಾಡಲಾಗುತ್ತದೆ."

          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви використали %lld%% свого місячного бюджету. Розгляньте можливість перегляду дискреційних витрат. 💡"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے اپنے ماہانہ بجٹ کا %lld%% استعمال کر لیا ہے۔ صوابدیدی اخراجات کا جائزہ لینے پر غور کریں۔ 💡"
          }

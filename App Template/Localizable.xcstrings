    "Great pace — you've only used %lld%% of your budget this month. Keep it up! 🎯": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "وتيرة رائعة — لقد استخدمت %lld%% فقط من ميزانيتك هذا الشهر. استمر! 🎯"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "দুর্দান্ত গতি — আপনি এই মাসে আপনার বাজেটের শুধুমাত্র %lld%% ব্যবহার করেছেন। এটা আপ রাখুন! 🎯"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolles Tempo – Sie haben diesen Monat nur %lld %% Ihres Budgets verwendet. Weiter so! 🎯"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Great pace — you've only used %lld%% of your budget this month. Keep it up! 🎯"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Great pace — you've only used %lld%% of your budget this month. Keep it up! 🎯"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Great pace — you've only used %lld%% of your budget this month. Keep it up! 🎯"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Great pace — you've only used %lld%% of your budget this month. Keep it up! 🎯"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen ritmo: solo has utilizado el %lld%% de tu presupuesto este mes. ¡Avanza! 🎯"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rythme soutenu : vous n'avez utilisé que %lld % % de votre budget ce mois-ci. Continuez comme ça! 🎯"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rythme soutenu : vous n'avez utilisé que %lld % % de votre budget ce mois-ci. Continuez comme ça! 🎯"
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉત્તમ ગતિ — તમે આ મહિને તમારા બજેટનો માત્ર %lld%% ઉપયોગ કર્યો છે. તેને ચાલુ રાખો! 🎯"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קצב מצוין - השתמשת רק ב-%lld%% מהתקציב שלך החודש. תמשיך כך! 🎯"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शानदार गति - आपने इस महीने अपने बजट का केवल %lld%% उपयोग किया है। इसे जारी रखो! 🎯"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjajan tempo — iskoristili ste samo %lld%% svog proračuna ovaj mjesec. Samo tako nastavi! 🎯"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecepatan yang luar biasa — Anda hanya menggunakan %lld%% anggaran Anda bulan ini. Lanjutkan kerja baikmu! 🎯"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimo ritmo: hai utilizzato solo il %lld%% del tuo budget questo mese. Continua così! 🎯"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素晴らしいペースです。今月は予算の %lld%% しか使用していません。それを維持する！ 🎯"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉತ್ತಮ ವೇಗ — ನೀವು ಈ ತಿಂಗಳು ನಿಮ್ಮ ಬಜೆಟ್‌ನ %lld%% ಅನ್ನು ಮಾತ್ರ ಬಳಸಿದ್ದೀರಿ. ಅದನ್ನು ಮುಂದುವರಿಸಿ! 🎯"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속도가 좋습니다. 이번 달 예산의 %lld%%만 사용했습니다. 계속하세요! 🎯"
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "മികച്ച വേഗത — ഈ മാസം നിങ്ങളുടെ ബജറ്റിൻ്റെ %lld%% മാത്രമേ നിങ്ങൾ ഉപയോഗിച്ചിട്ടുള്ളൂ. നിലനിർത്തുക! 🎯"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्तम गती — तुम्ही या महिन्यात तुमच्या बजेटपैकी फक्त %lld%% वापरला आहे. ते चालू ठेवा! 🎯"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kepantasan yang hebat — anda hanya menggunakan %lld%% daripada belanjawan anda bulan ini. Teruskan! 🎯"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Godt tempo – du har bare brukt %lld%% av budsjettet ditt denne måneden. Fortsett med det! 🎯"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Geweldig tempo: u heeft deze maand slechts %lld%% van uw budget gebruikt. Ga zo door! 🎯"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦରୁଣ ଗତି — ଏହି ମାସରେ ଆପଣ ବଜେଟର କେବଳ %1$lld%% ବ୍ୟବହାର କରିଛନ୍ତି। ଏହା ଜାରି ରଖନ୍ତୁ! 🎯"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼ਾਨਦਾਰ ਰਫ਼ਤਾਰ — ਤੁਸੀਂ ਇਸ ਮਹੀਨੇ ਆਪਣੇ ਬਜਟ ਦਾ ਸਿਰਫ਼ %lld%% ਹੀ ਵਰਤਿਆ ਹੈ। ਲੱਗੇ ਰਹੋ! 🎯"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo ritmo: você usou apenas %lld%% do seu orçamento este mês. Mantem! 🎯"
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "சிறந்த வேகம் — இந்த மாதம் உங்கள் பட்ஜெட்டில் %lld%% மட்டுமே பயன்படுத்தியுள்ளீர்கள். தொடருங்கள்! 🎯"
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "గొప్ప వేగం — మీరు ఈ నెలలో మీ బడ్జెట్‌లో %lld%% మాత్రమే ఉపయోగించారు. కొనసాగించు! 🎯"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก้าวไปอย่างรวดเร็ว — คุณใช้งบประมาณไปเพียง %lld%% ในเดือนนี้ ติดตามมัน! 🎯"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika bir tempo — bu ay bütçenizin yalnızca %%%lld kadarını kullandınız. Aynen böyle devam! 🎯"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чудовий темп — цього місяця ви використали лише %lld%% свого бюджету. Так тримати! 🎯"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "زبردست رفتار — آپ نے اس مہینے اپنے بجٹ کا صرف %lld%% استعمال کیا ہے۔ اسے جاری رکھیں! 🎯"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốc độ nhanh — bạn mới chỉ sử dụng %lld%% ngân sách của mình trong tháng này. Giữ nó lên! 🎯"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "速度很快 - 您本月仅使用了预算的 %lld%%。继续努力吧！ 🎯"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "速度很快 - 您本月僅使用了預算的 %lld%%。繼續努力！ 🎯"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Godt tempo – du har bare brukt %lld%% av budsjettet ditt denne måneden. Fortsett med det! 🎯"

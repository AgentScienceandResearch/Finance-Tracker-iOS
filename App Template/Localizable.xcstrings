        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "સમગ્ર એપ્લિકેશનમાં વ્યવહારો, બજેટ, આવક અને રિકરિંગ બિલ બનાવો અથવા સંપાદિત કરો."

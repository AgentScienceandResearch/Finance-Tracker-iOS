    "Couldn't load plans. Please try again.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل الخطط. يرجى المحاولة مرة أخرى."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "প্ল্যান লোড করা যায়নি। আবার চেষ্টা করুন."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Pläne konnten nicht geladen werden. Bitte versuchen Sie es erneut."
          }
        },
        "en-AU": {

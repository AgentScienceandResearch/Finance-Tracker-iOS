        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉತ್ತಮ ಬೆಳಕು ಅಥವಾ ಹೊಗಳಿಕೆಯ ದಾಖಲೆಯೊಂದಿಗೆ ಮತ್ತೊಮ್ಮೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಲು ಪ್ರಯತ್ನಿಸಿ."

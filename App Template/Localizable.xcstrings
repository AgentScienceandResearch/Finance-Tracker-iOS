    "Finance AI connects your transactions, trends, recurring bills, and approvals.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI يربط معاملاتك واتجاهاتك وفواتيرك المتكررة والموافقات."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI আপনার লেনদেন, প্রবণতা, পুনরাবৃত্ত বিল এবং অনুমোদন সংযুক্ত করে।"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI verbindet Ihre Transaktionen, Trends, wiederkehrenden Rechnungen und Genehmigungen."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI connects your transactions, trends, recurring bills, and approvals."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI connects your transactions, trends, recurring bills, and approvals."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI connects your transactions, trends, recurring bills, and approvals."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI connects your transactions, trends, recurring bills, and approvals."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI conecta sus transacciones, tendencias, facturas recurrentes y aprobaciones."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI connecte vos transactions, tendances, factures récurrentes et approbations."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI connecte vos transactions, tendances, factures récurrentes et approbations."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI તમારા વ્યવહારો, વલણો, રિકરિંગ બિલ્સ અને મંજૂરીઓને જોડે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI מחבר את העסקאות, המגמות, החשבונות החוזרים והאישורים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI आपके लेन-देन, रुझान, आवर्ती बिल और अनुमोदन को जोड़ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI povezuje vaše transakcije, trendove, ponavljajuće račune i odobrenja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI menghubungkan transaksi, tren, tagihan berulang, dan persetujuan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI collega transazioni, tendenze, fatture ricorrenti e approvazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI は、トランザクション、トレンド、定期的な請求、承認を結び付けます。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI ನಿಮ್ಮ ವಹಿವಾಟುಗಳು, ಪ್ರವೃತ್ತಿಗಳು, ಮರುಕಳಿಸುವ ಬಿಲ್‌ಗಳು ಮತ್ತು ಅನುಮೋದನೆಗಳನ್ನು ಸಂಪರ್ಕಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI는 거래, 동향, 반복 청구서 및 승인을 연결합니다."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI നിങ്ങളുടെ ഇടപാടുകൾ, ട്രെൻഡുകൾ, ആവർത്തിച്ചുള്ള ബില്ലുകൾ, അംഗീകാരങ്ങൾ എന്നിവ ബന്ധിപ്പിക്കുന്നു."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI तुमचे व्यवहार, ट्रेंड, आवर्ती बिले आणि मंजूरी जोडते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI menghubungkan urus niaga, aliran, bil berulang dan kelulusan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI kobler sammen transaksjoner, trender, gjentakende regninger og godkjenninger."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI verbindt uw transacties, trends, terugkerende facturen en goedkeuringen."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI ତୁମର କାରବାର, ଟ୍ରେଣ୍ଡ, ବାରମ୍ବାର ବିଲ୍, ଏବଂ ଅନୁମୋଦନକୁ ସଂଯୋଗ କରେ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI ਤੁਹਾਡੇ ਲੈਣ-ਦੇਣ, ਰੁਝਾਨ, ਆਵਰਤੀ ਬਿੱਲਾਂ, ਅਤੇ ਮਨਜ਼ੂਰੀਆਂ ਨੂੰ ਜੋੜਦਾ ਹੈ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI conecta suas transações, tendências, faturas recorrentes e aprovações."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI உங்கள் பரிவர்த்தனைகள், போக்குகள், தொடர்ச்சியான பில்கள் மற்றும் ஒப்புதல்களை இணைக்கிறது."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI మీ లావాదేవీలు, ట్రెండ్‌లు, పునరావృత బిల్లులు మరియు ఆమోదాలను కలుపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI เชื่อมโยงธุรกรรม แนวโน้ม การเรียกเก็บเงินประจำ และการอนุมัติของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI işlemlerinizi, trendlerinizi, yinelenen faturalarınızı ve onaylarınızı birbirine bağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI поєднує ваші транзакції, тенденції, регулярні рахунки та схвалення."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI آپ کے لین دین، رجحانات، اعادی بلوں اور منظوریوں کو جوڑتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI kết nối các giao dịch, xu hướng, hóa đơn định kỳ và phê duyệt của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI 连接您的交易、趋势、经常性账单和审批。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI 連接您的交易、趨勢、經常性帳單和核准。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI kobler sammen transaksjoner, trender, gjentakende regninger og godkjenninger."
          }
        }
      }
    },
    "Finance AI prepares every change for your review and only applies what you approve.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI يقوم بإعداد كل تغيير لمراجعتك ويطبق فقط ما توافق عليه."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI আপনার পর্যালোচনার জন্য প্রতিটি পরিবর্তন প্রস্তুত করে এবং শুধুমাত্র আপনি যা অনুমোদন করেন তা প্রয়োগ করে।"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI bereitet jede Änderung für Ihre Überprüfung vor und wendet nur das an, was Sie genehmigen."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI prepares every change for your review and only applies what you approve."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI prepares every change for your review and only applies what you approve."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI prepares every change for your review and only applies what you approve."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI prepares every change for your review and only applies what you approve."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI prepara cada cambio para su revisión y solo aplica lo que usted aprueba."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI prépare chaque modification pour votre examen et applique uniquement ce que vous approuvez."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI prépare chaque modification pour votre examen et applique uniquement ce que vous approuvez."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI તમારી સમીક્ષા માટે દરેક ફેરફારને તૈયાર કરે છે અને તમે જે મંજૂર કરો છો તેને જ લાગુ કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI מכין כל שינוי לבדיקה שלך ומחיל רק את מה שאתה מאשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI आपकी समीक्षा के लिए प्रत्येक परिवर्तन तैयार करता है और केवल वही लागू करता है जिसे आप स्वीकार करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI priprema svaku promjenu za vaš pregled i primjenjuje samo ono što vi odobrite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI menyiapkan setiap perubahan untuk tinjauan Anda dan hanya menerapkan apa yang Anda setujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI prepara ogni modifica per la tua revisione e applica solo ciò che approvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI は、すべての変更をレビュー用に準備し、承認したもののみを適用します。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI ನಿಮ್ಮ ವಿಮರ್ಶೆಗಾಗಿ ಪ್ರತಿ ಬದಲಾವಣೆಯನ್ನು ಸಿದ್ಧಪಡಿಸುತ್ತದೆ ಮತ್ತು ನೀವು ಅನುಮೋದಿಸುವುದನ್ನು ಮಾತ್ರ ಅನ್ವಯಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI에서는 검토를 위해 모든 변경사항을 준비하고 승인된 사항만 적용합니다."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI നിങ്ങളുടെ അവലോകനത്തിനായി എല്ലാ മാറ്റങ്ങളും തയ്യാറാക്കുകയും നിങ്ങൾ അംഗീകരിക്കുന്നത് മാത്രം ബാധകമാക്കുകയും ചെയ്യുന്നു."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI तुमच्या पुनरावलोकनासाठी प्रत्येक बदल तयार करते आणि तुम्ही जे मंजूर करता तेच लागू होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI menyediakan setiap perubahan untuk semakan anda dan hanya menggunakan perkara yang anda luluskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI forbereder hver endring for vurderingen din og bruker bare det du godkjenner."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI bereidt elke wijziging voor op uw beoordeling en past alleen toe wat u goedkeurt."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI ଆପଣଙ୍କର ସମୀକ୍ଷା ପାଇଁ ପ୍ରତ୍ୟେକ ପରିବର୍ତ୍ତନ ପ୍ରସ୍ତୁତ କରେ ଏବଂ ଆପଣ ଯାହା ଅନୁମୋଦନ କରନ୍ତି ତାହା କେବଳ ପ୍ରୟୋଗ ହୁଏ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI ਤੁਹਾਡੀ ਸਮੀਖਿਆ ਲਈ ਹਰ ਪਰਿਵਰਤਨ ਨੂੰ ਤਿਆਰ ਕਰਦਾ ਹੈ ਅਤੇ ਸਿਰਫ਼ ਉਸ ਨੂੰ ਲਾਗੂ ਕਰਦਾ ਹੈ ਜੋ ਤੁਸੀਂ ਮਨਜ਼ੂਰ ਕਰਦੇ ਹੋ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI prepara todas as alterações para sua revisão e aplica apenas o que você aprova."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI உங்கள் மதிப்பாய்வுக்காக ஒவ்வொரு மாற்றத்தையும் தயார் செய்து, நீங்கள் அனுமதிப்பதை மட்டுமே பயன்படுத்துகிறது."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI మీ సమీక్ష కోసం ప్రతి మార్పును సిద్ధం చేస్తుంది మరియు మీరు ఆమోదించిన వాటిని మాత్రమే వర్తింపజేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI เตรียมการเปลี่ยนแปลงทุกอย่างเพื่อให้คุณตรวจสอบและใช้เฉพาะสิ่งที่คุณอนุมัติเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI her değişikliği incelemeniz için hazırlar ve yalnızca onayladığınız şeyleri uygular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI готує кожну зміну до вашого перегляду та застосовує лише те, що ви погоджуєте."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI ہر تبدیلی کو آپ کے جائزے کے لیے تیار کرتا ہے اور صرف وہی لاگو کرتا ہے جسے آپ منظور کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI chuẩn bị mọi thay đổi để bạn xem xét và chỉ áp dụng những gì bạn phê duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI 准备每项更改以供您审核，并且仅应用您批准的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI 準備每項變更以供您審核，並且僅套用您核准的內容。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Finance AI forbereder hver endring for vurderingen din og bruker bare det du godkjenner."
          }
        }
      }
    },

        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastaste %1$@ en %2$@ este mes, lo que representa el %3$lld%% del gasto total."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez dépensé %1$@ pour %2$@ ce mois-ci, ce qui représente %3$lld%% de vos dépenses totales."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez dépensé %1$@ pour %2$@ ce mois-ci, ce qui représente %3$lld%% de vos dépenses totales."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે આ મહિને %2$@ પર %1$@ ખર્ચ્યા, જે કુલ ખર્ચના %3$lld%% છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוצאת %1$@ על %2$@ החודש, שהם %3$lld%% מסך ההוצאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने इस महीने %2$@ पर %1$@ खर्च किया, जो कुल खर्च का %3$lld%% है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj ste mjesec potrošili %1$@ na %2$@, što je %3$lld%% ukupne potrošnje."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda membelanjakan %1$@ pada %2$@ bulan ini, yaitu %3$lld%% dari total pembelanjaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai speso %1$@ il %2$@ questo mese, ovvero il %3$lld%% della spesa totale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月 %2$@ に %1$@ を費やしました。これは総支出の %3$lld%% に相当します。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಈ ತಿಂಗಳು %1$@ ಅನ್ನು %2$@ ನಲ್ಲಿ ಕಳೆದಿದ್ದೀರಿ, ಇದು ಒಟ್ಟು ಖರ್ಚಿನ %3$lld%% ಆಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 %2$@에 %1$@을(를) 지출했습니다. 이는 총 지출의 %3$lld%%입니다."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഈ മാസം %2$@-ന് %1$@ ചെലവഴിച്ചു, ഇത് മൊത്തം ചെലവിൻ്റെ %3$lld%% ആണ്."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही या महिन्यात %2$@ रोजी %1$@ खर्च केले, जे एकूण खर्चाच्या %3$lld%% आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda membelanjakan %1$@ pada %2$@ bulan ini, iaitu %3$lld%% daripada jumlah perbelanjaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brukte %1$@ på %2$@ denne måneden, som er %3$lld%% av det totale forbruket."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "U heeft deze maand %1$@ uitgegeven aan %2$@, wat neerkomt op %3$lld%% van de totale uitgaven."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଏହି ମାସରେ %2$@ ପାଇଁ %1$@ ଖର୍ଚ୍ଚ କରିଛନ୍ତି, ଯାହା ମୋଟ ଖର୍ଚ୍ଚର %3$lld%%।"

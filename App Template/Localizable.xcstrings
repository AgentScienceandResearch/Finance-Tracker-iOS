        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ପରୀକ୍ଷା ଶେଷ ନହେବା ପର୍ଯ୍ୟନ୍ତ ପ୍ରତ୍ୟେକ ବ feature ଶିଷ୍ଟ୍ୟ, ଶୂନ ଚାର୍ଜ |"

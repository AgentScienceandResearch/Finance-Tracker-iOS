        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப்ஸ் முழுவதும் பரிவர்த்தனைகள், பட்ஜெட்கள், வருமானம் மற்றும் தொடர்ச்சியான பில்களை உருவாக்கவும் அல்லது திருத்தவும்."
          }
        },
        "te-IN": {

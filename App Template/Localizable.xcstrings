          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Al suscribirte aceptas nuestra"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En vous abonnant, vous acceptez notre"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En vous abonnant, vous acceptez notre"
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "સબ્સ્ક્રાઇબ કરીને તમે અમારી સાથે સંમત થાઓ છો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "על ידי הרשמה אתה מסכים לנו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता लेकर आप हमारी बात से सहमत होते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretplatom se slažete s našim"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan berlangganan, Anda menyetujui kami"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iscrivendoti accetti il ns"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読すると、次のことに同意したものとみなされます"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಂದಾದಾರರಾಗುವ ಮೂಲಕ ನೀವು ನಮ್ಮ ಸಮ್ಮತಿಸುತ್ತೀರಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독하면 다음 내용에 동의하게 됩니다."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "സബ്‌സ്‌ക്രൈബ് ചെയ്യുന്നതിലൂടെ നിങ്ങൾ ഞങ്ങളുടെത് അംഗീകരിക്കുന്നു"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता घेऊन तुम्ही आमच्याशी सहमत आहात"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan melanggan anda bersetuju dengan kami"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved å abonnere godtar du vår"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Door u te abonneren gaat u akkoord met onze"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ସବସ୍କ୍ରାଇବ୍ କରି ତୁମେ ଆମର ସହମତ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਬਸਕ੍ਰਾਈਬ ਕਰਕੇ ਤੁਸੀਂ ਸਾਡੇ ਨਾਲ ਸਹਿਮਤ ਹੁੰਦੇ ਹੋ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao se inscrever você concorda com nossos"
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "சந்தா செலுத்துவதன் மூலம் நீங்கள் எங்களுடையதை ஒப்புக்கொள்கிறீர்கள்"
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "సబ్‌స్క్రయిబ్ చేయడం ద్వారా మీరు మాకి అంగీకరిస్తున్నారు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดยการสมัครคุณยอมรับของเรา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abone olarak şunları kabul etmiş olursunuz:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписуючись, ви погоджуєтеся з нашими"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "سبسکرائب کر کے آپ ہماری بات سے اتفاق کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bằng cách đăng ký, bạn đồng ý với chúng tôi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅即表示您同意我们的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱即表示您同意我們的"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved å abonnere godtar du vår"
          }
        }
      }

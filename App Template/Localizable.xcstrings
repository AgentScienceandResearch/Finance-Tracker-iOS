        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cambió o ya no existe."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a changé ou n'existe plus."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a changé ou n'existe plus."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ બદલાયેલ છે અથવા હવે અસ્તિત્વમાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ השתנה או אינו קיים יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बदल गया है या अब मौजूद नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ promijenjeno ili više ne postoji."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ berubah atau tidak ada lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è cambiato o non esiste più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は変更されたか、存在しません。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಬದಲಾಗಿದೆ ಅಥವಾ ಅಸ್ತಿತ್ವದಲ್ಲಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이 변경되었거나 더 이상 존재하지 않습니다."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ മാറ്റി അല്ലെങ്കിൽ നിലവിലില്ല."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बदलले किंवा यापुढे अस्तित्वात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ berubah atau tidak wujud lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ endret eller eksisterer ikke lenger."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gewijzigd of bestaat niet meer."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ପରିବର୍ତ୍ତିତ ହୋଇଛି କିମ୍ବା ଆଉ ନାହିଁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਬਦਲਿਆ ਗਿਆ ਹੈ ਜਾਂ ਹੁਣ ਮੌਜੂਦ ਨਹੀਂ ਹੈ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi alterado ou não existe mais."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ மாற்றப்பட்டது அல்லது இல்லை."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ మార్చబడింది లేదా ఉనికిలో లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ มีการเปลี่ยนแปลงหรือไม่มีอยู่อีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {

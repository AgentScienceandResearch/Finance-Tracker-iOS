        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tus suscripciones y facturas para realizar un seguimiento automático"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos abonnements et factures pour les suivre automatiquement"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos abonnements et factures pour les suivre automatiquement"
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા સબ્સ્ક્રિપ્શન્સ અને બિલ્સને આપમેળે ટ્રૅક કરવા માટે ઉમેરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף את המנויים והחשבונות שלך כדי לעקוב אחריהם באופן אוטומטי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सदस्यताओं और बिलों को स्वचालित रूप से ट्रैक करने के लिए उन्हें जोड़ें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte svoje pretplate i račune kako biste ih automatski pratili"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan langganan dan tagihan Anda untuk melacaknya secara otomatis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i tuoi abbonamenti e le tue fatture per monitorarli automaticamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションと請求書を追加して自動的に追跡します"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಚಂದಾದಾರಿಕೆಗಳು ಮತ್ತು ಬಿಲ್‌ಗಳನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಟ್ರ್ಯಾಕ್ ಮಾಡಲು ಸೇರಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독 및 청구서를 추가하여 자동으로 추적하세요."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സബ്‌സ്‌ക്രിപ്‌ഷനുകളും ബില്ലുകളും സ്വയമേവ ട്രാക്ക് ചെയ്യാൻ ചേർക്കുക"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची सदस्यता आणि बिले स्वयंचलितपणे ट्रॅक करण्यासाठी जोडा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan langganan dan bil anda untuk menjejakinya secara automatik"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til dine abonnementer og regninger for å spore dem automatisk"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg uw abonnementen en facturen toe om ze automatisch bij te houden"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍ୱୟଂଚାଳିତ ଭାବରେ ଟ୍ରାକ୍ କରିବାକୁ ଆପଣଙ୍କର ସଦସ୍ୟତା ଏବଂ ବିଲ୍ ଯୋଡନ୍ତୁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹਨਾਂ ਨੂੰ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਟਰੈਕ ਕਰਨ ਲਈ ਆਪਣੀਆਂ ਗਾਹਕੀਆਂ ਅਤੇ ਬਿੱਲਾਂ ਨੂੰ ਸ਼ਾਮਲ ਕਰੋ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione suas assinaturas e contas para rastreá-las automaticamente"
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "தானாக கண்காணிக்க உங்கள் சந்தாக்கள் மற்றும் பில்களைச் சேர்க்கவும்"
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "స్వయంచాలకంగా ట్రాక్ చేయడానికి మీ సభ్యత్వాలు మరియు బిల్లులను జోడించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มการสมัครสมาชิกและใบเรียกเก็บเงินของคุณเพื่อติดตามโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneliklerinizi ve faturalarınızı otomatik olarak takip etmek için ekleyin"

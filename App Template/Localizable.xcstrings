    "Your finances stay protected. Nothing changes without your approval.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اموالك تبقى محمية. لا شيء يتغير دون موافقتك."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার আর্থিক সুরক্ষিত থাকুন. আপনার অনুমোদন ছাড়া কিছুই পরিবর্তন."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Finanzen bleiben geschützt. Ohne Ihre Zustimmung ändert sich nichts."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your finances stay protected. Nothing changes without your approval."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Your finances stay protected. Nothing changes without your approval."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your finances stay protected. Nothing changes without your approval."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your finances stay protected. Nothing changes without your approval."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus finanzas permanecen protegidas. Nada cambia sin tu aprobación."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos finances restent protégées. Rien ne change sans votre approbation."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos finances restent protégées. Rien ne change sans votre approbation."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી નાણાકીય બાબતો સુરક્ષિત રહે છે. તમારી મંજૂરી વિના કંઈપણ બદલાતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכספים שלך נשארים מוגנים. שום דבר לא משתנה ללא אישורך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वित्त सुरक्षित रहता है। आपकी मंजूरी के बिना कुछ भी नहीं बदलता."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše financije ostaju zaštićene. Ništa se ne mijenja bez vašeg odobrenja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keuangan Anda tetap terlindungi. Tidak ada yang berubah tanpa persetujuan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue finanze rimangono protette. Niente cambia senza la tua approvazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの財政は保護され続けます。あなたの承認がなければ何も変わりません。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಹಣಕಾಸು ಸಂರಕ್ಷಿತವಾಗಿರುತ್ತದೆ. ನಿಮ್ಮ ಅನುಮೋದನೆಯಿಲ್ಲದೆ ಏನೂ ಬದಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 재정은 보호됩니다. 귀하의 승인 없이는 아무것도 변경되지 않습니다."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സാമ്പത്തികം സംരക്ഷിക്കപ്പെട്ടിരിക്കുന്നു. നിങ്ങളുടെ അംഗീകാരമില്ലാതെ ഒന്നും മാറില്ല."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे आर्थिक संरक्षण सुरक्षित राहतील. तुमच्या संमतीशिवाय काहीही बदलत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kewangan anda kekal dilindungi. Tiada apa-apa perubahan tanpa kelulusan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din økonomi forblir beskyttet. Ingenting endres uten din godkjenning."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw financiën blijven beschermd. Er verandert niets zonder uw goedkeuring."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ଆର୍ଥିକ ସୁରକ୍ଷିତ ରୁହ | ଆପଣଙ୍କ ଅନୁମୋଦନ ବିନା କିଛି ପରିବର୍ତ୍ତନ ହୁଏ ନାହିଁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਵਿੱਤ ਸੁਰੱਖਿਅਤ ਰਹਿੰਦੇ ਹਨ। ਤੁਹਾਡੀ ਮਨਜ਼ੂਰੀ ਤੋਂ ਬਿਨਾਂ ਕੁਝ ਨਹੀਂ ਬਦਲਦਾ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas finanças ficam protegidas. Nada muda sem a sua aprovação."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நிதி பாதுகாக்கப்படும். உங்கள் ஒப்புதல் இல்லாமல் எதுவும் மாறாது."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఆర్థిక పరిస్థితులు భద్రంగా ఉంటాయి. మీ ఆమోదం లేకుండా ఏదీ మారదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเงินของคุณได้รับการคุ้มครอง ไม่มีการเปลี่ยนแปลงใด ๆ หากไม่ได้รับการอนุมัติจากคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mali durumunuz korunur. Onayınız olmadan hiçbir şey değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші фінанси залишаються захищеними. Ніщо не змінюється без вашого схвалення."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے مالیات محفوظ رہیں۔ آپ کی منظوری کے بغیر کچھ نہیں بدلتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài chính của bạn luôn được bảo vệ. Không có gì thay đổi nếu không có sự chấp thuận của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的财务状况将受到保护。未经您的批准，任何事情都不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的財務狀況將受到保護。未經您的批准，任何事情都不會改變。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Din økonomi forblir beskyttet. Ingenting endres uten din godkjenning."
          }
        }
      }
    },

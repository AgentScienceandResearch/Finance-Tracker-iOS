        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ವೈಶಿಷ್ಟ್ಯ, ನಿಮ್ಮ ಪ್ರಯೋಗ ಮುಗಿಯುವವರೆಗೆ ಶೂನ್ಯ ಶುಲ್ಕ."

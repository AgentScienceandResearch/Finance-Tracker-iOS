    "I can analyze your finances and help manage transactions, income, budgets, and recurring bills. Any change stays pending until you review and approve it.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنني تحليل أموالك والمساعدة في إدارة المعاملات والدخل والميزانيات والفواتير المتكررة. ويظل أي تغيير معلقًا حتى تقوم بمراجعته والموافقة عليه."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি আপনার আর্থিক বিশ্লেষণ করতে পারি এবং লেনদেন, আয়, বাজেট এবং পুনরাবৃত্ত বিল পরিচালনা করতে সহায়তা করতে পারি। আপনি এটি পর্যালোচনা এবং অনুমোদন না করা পর্যন্ত যেকোনো পরিবর্তন মুলতুবি থাকে।"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann Ihre Finanzen analysieren und Ihnen bei der Verwaltung von Transaktionen, Einnahmen, Budgets und wiederkehrenden Rechnungen helfen. Jede Änderung bleibt ausstehend, bis Sie sie überprüfen und genehmigen."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "I can analyze your finances and help manage transactions, income, budgets, and recurring bills. Any change stays pending until you review and approve it."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "I can analyze your finances and help manage transactions, income, budgets, and recurring bills. Any change stays pending until you review and approve it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "I can analyze your finances and help manage transactions, income, budgets, and recurring bills. Any change stays pending until you review and approve it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "I can analyze your finances and help manage transactions, income, budgets, and recurring bills. Any change stays pending until you review and approve it."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedo analizar tus finanzas y ayudarte a gestionar transacciones, ingresos, presupuestos y facturas recurrentes. Cualquier cambio permanece pendiente hasta que lo revise y apruebe."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux analyser vos finances et vous aider à gérer les transactions, les revenus, les budgets et les factures récurrentes. Toute modification reste en attente jusqu'à ce que vous l'examiniez et l'approuviez."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux analyser vos finances et vous aider à gérer les transactions, les revenus, les budgets et les factures récurrentes. Toute modification reste en attente jusqu'à ce que vous l'examiniez et l'approuviez."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "હું તમારી નાણાકીય બાબતોનું વિશ્લેષણ કરી શકું છું અને વ્યવહારો, આવક, બજેટ અને રિકરિંગ બિલનું સંચાલન કરવામાં મદદ કરી શકું છું. જ્યાં સુધી તમે તેની સમીક્ષા અને મંજૂર ન કરો ત્યાં સુધી કોઈપણ ફેરફાર બાકી રહે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני יכול לנתח את הכספים שלך ולעזור בניהול עסקאות, הכנסות, תקציבים וחשבונות חוזרים. כל שינוי נשאר בהמתנה עד שתבדוק ותאשר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं आपके वित्त का विश्लेषण कर सकता हूं और लेनदेन, आय, बजट और आवर्ती बिलों को प्रबंधित करने में मदद कर सकता हूं। कोई भी परिवर्तन तब तक लंबित रहता है जब तक आप उसकी समीक्षा और अनुमोदन नहीं कर देते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogu analizirati vaše financije i pomoći u upravljanju transakcijama, prihodima, proračunima i tekućim računima. Svaka promjena ostaje na čekanju dok je ne pregledate i odobrite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya dapat menganalisis keuangan Anda dan membantu mengelola transaksi, pendapatan, anggaran, dan tagihan berulang. Perubahan apa pun akan tetap tertunda sampai Anda meninjau dan menyetujuinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso analizzare le tue finanze e aiutarti a gestire transazioni, entrate, budget e fatture ricorrenti. Qualsiasi modifica rimane in sospeso finché non la rivedi e la approvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの財務を分析し、取引、収入、予算、定期的な請求書の管理をお手伝いします。変更は、レビューして承認するまで保留状態になります。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು ನಿಮ್ಮ ಹಣಕಾಸುಗಳನ್ನು ವಿಶ್ಲೇಷಿಸಬಲ್ಲೆ ಮತ್ತು ವಹಿವಾಟುಗಳು, ಆದಾಯ, ಬಜೆಟ್‌ಗಳು ಮತ್ತು ಮರುಕಳಿಸುವ ಬಿಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಲು ಸಹಾಯ ಮಾಡಬಹುದು. ನೀವು ಅದನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಅನುಮೋದಿಸುವವರೆಗೆ ಯಾವುದೇ ಬದಲಾವಣೆಯು ಬಾಕಿ ಉಳಿದಿರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저는 귀하의 재정을 분석하고 거래, 수입, 예산 및 반복 청구서를 관리하는 데 도움을 드릴 수 있습니다. 모든 변경 사항은 귀하가 검토하고 승인할 때까지 보류 상태로 유지됩니다."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "എനിക്ക് നിങ്ങളുടെ സാമ്പത്തികം വിശകലനം ചെയ്യാനും ഇടപാടുകൾ, വരുമാനം, ബജറ്റുകൾ, ആവർത്തിച്ചുള്ള ബില്ലുകൾ എന്നിവ നിയന്ത്രിക്കാനും സഹായിക്കാനാകും. നിങ്ങൾ അത് അവലോകനം ചെയ്യുകയും അംഗീകരിക്കുകയും ചെയ്യുന്നതുവരെ ഏത് മാറ്റവും തീർച്ചപ്പെടുത്തിയിട്ടില്ല."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "मी तुमच्या वित्ताचे विश्लेषण करू शकतो आणि व्यवहार, उत्पन्न, बजेट आणि आवर्ती बिले व्यवस्थापित करण्यात मदत करू शकतो. तुम्ही त्याचे पुनरावलोकन करून मंजूर करेपर्यंत कोणताही बदल प्रलंबित राहतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya boleh menganalisis kewangan anda dan membantu mengurus urus niaga, pendapatan, belanjawan dan bil berulang. Sebarang perubahan masih belum selesai sehingga anda menyemak dan meluluskannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg kan analysere din økonomi og hjelpe til med å administrere transaksjoner, inntekter, budsjetter og gjentakende regninger. Eventuelle endringer forblir ventende til du vurderer og godkjenner den."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kan uw financiën analyseren en helpen bij het beheren van transacties, inkomsten, budgetten en terugkerende rekeningen. Elke wijziging blijft in behandeling totdat u deze controleert en goedkeurt."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ମୁଁ ତୁମର ଆର୍ଥିକ ବିଶ୍ଳେଷଣ କରିପାରିବି ଏବଂ କାରବାର, ଆୟ, ବଜେଟ୍ ଏବଂ ବାରମ୍ବାର ବିଲ୍ ପରିଚାଳନା କରିବାରେ ସାହାଯ୍ୟ କରିପାରିବି | ଯେପର୍ଯ୍ୟନ୍ତ ଆପଣ ଏହାକୁ ସମୀକ୍ଷା ଏବଂ ଅନୁମୋଦନ ନକରନ୍ତି ସେ ପର୍ଯ୍ୟନ୍ତ ଯେକ Any ଣସି ପରିବର୍ତ୍ତନ ବିଚାରାଧୀନ ରହିଥାଏ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਂ ਤੁਹਾਡੇ ਵਿੱਤ ਦਾ ਵਿਸ਼ਲੇਸ਼ਣ ਕਰ ਸਕਦਾ ਹਾਂ ਅਤੇ ਲੈਣ-ਦੇਣ, ਆਮਦਨ, ਬਜਟ, ਅਤੇ ਆਵਰਤੀ ਬਿੱਲਾਂ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰਨ ਵਿੱਚ ਮਦਦ ਕਰ ਸਕਦਾ ਹਾਂ। ਕੋਈ ਵੀ ਤਬਦੀਲੀ ਉਦੋਂ ਤੱਕ ਲੰਬਿਤ ਰਹਿੰਦੀ ਹੈ ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਇਸਦੀ ਸਮੀਖਿਆ ਅਤੇ ਮਨਜ਼ੂਰੀ ਨਹੀਂ ਦਿੰਦੇ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso analisar suas finanças e ajudar a gerenciar transações, receitas, orçamentos e contas recorrentes. Qualquer alteração permanece pendente até que você a revise e aprove."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "நான் உங்கள் நிதியை பகுப்பாய்வு செய்து, பரிவர்த்தனைகள், வருமானம், பட்ஜெட்கள் மற்றும் தொடர்ச்சியான பில்களை நிர்வகிக்க உதவ முடியும். நீங்கள் மதிப்பாய்வு செய்து அங்கீகரிக்கும் வரை எந்த மாற்றமும் நிலுவையில் இருக்கும்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను మీ ఆర్థిక వ్యవహారాలను విశ్లేషించి, లావాదేవీలు, ఆదాయం, బడ్జెట్‌లు మరియు పునరావృత బిల్లులను నిర్వహించడంలో సహాయపడగలను. మీరు సమీక్షించి, ఆమోదించే వరకు ఏదైనా మార్పు పెండింగ్‌లో ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันสามารถวิเคราะห์การเงินของคุณและช่วยจัดการธุรกรรม รายได้ งบประมาณ และใบเรียกเก็บเงินประจำ การเปลี่ยนแปลงใดๆ จะยังคงรอดำเนินการจนกว่าคุณจะตรวจสอบและอนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mali durumunuzu analiz edebilir ve işlemleri, geliri, bütçeleri ve yinelenen faturaları yönetmenize yardımcı olabilirim. Herhangi bir değişiklik, siz inceleyip onaylayana kadar beklemede kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я можу проаналізувати ваші фінанси та допомогти керувати транзакціями, доходами, бюджетами та регулярними рахунками. Будь-які зміни залишаються на розгляді, доки ви їх не переглянете та не затвердите."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "میں آپ کے مالیات کا تجزیہ کر سکتا ہوں اور لین دین، آمدنی، بجٹ اور اعادی بلوں کا انتظام کرنے میں مدد کر سکتا ہوں۔ کوئی بھی تبدیلی اس وقت تک زیر التواء رہتی ہے جب تک آپ اس کا جائزہ نہیں لیتے اور اسے منظور نہیں کرتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi có thể phân tích tài chính của bạn và giúp quản lý các giao dịch, thu nhập, ngân sách và hóa đơn định kỳ. Mọi thay đổi vẫn đang chờ xử lý cho đến khi bạn xem xét và phê duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我可以分析您的财务状况并帮助管理交易、收入、预算和经常性账单。在您审核并批准之前，任何更改都将保持待定状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我可以分析您的財務狀況並幫助管理交易、收入、預算和經常性帳單。在您審核並批准之前，任何變更都將保持待定狀態。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg kan analysere din økonomi og hjelpe til med å administrere transaksjoner, inntekter, budsjetter og gjentakende regninger. Eventuelle endringer forblir ventende til du vurderer og godkjenner den."
          }
        }
      }

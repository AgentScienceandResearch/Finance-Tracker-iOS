    "Session reset. I can analyze or manage transactions, budgets, and recurring bills whenever you're ready.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تعيين الجلسة. يمكنني تحليل أو إدارة المعاملات والميزانيات والفواتير المتكررة عندما تكون مستعدًا."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "সেশন রিসেট। আপনি যখনই প্রস্তুত থাকবেন আমি লেনদেন, বাজেট এবং পুনরাবৃত্ত বিল বিশ্লেষণ বা পরিচালনা করতে পারি।"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung zurückgesetzt. Ich kann Transaktionen, Budgets und wiederkehrende Rechnungen analysieren oder verwalten, wann immer Sie dazu bereit sind."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Session reset. I can analyze or manage transactions, budgets, and recurring bills whenever you're ready."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Session reset. I can analyze or manage transactions, budgets, and recurring bills whenever you're ready."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Session reset. I can analyze or manage transactions, budgets, and recurring bills whenever you're ready."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Session reset. I can analyze or manage transactions, budgets, and recurring bills whenever you're ready."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecimiento de sesión. Puedo analizar o administrar transacciones, presupuestos y facturas recurrentes cuando estés listo."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialisation de la session. Je peux analyser ou gérer les transactions, les budgets et les factures récurrentes quand vous êtes prêt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialisation de la session. Je peux analyser ou gérer les transactions, les budgets et les factures récurrentes quand vous êtes prêt."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "સત્ર રીસેટ. જ્યારે પણ તમે તૈયાર હોવ ત્યારે હું વ્યવહારો, બજેટ અને રિકરિંગ બિલનું વિશ્લેષણ અથવા સંચાલન કરી શકું છું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איפוס הפעלה. אני יכול לנתח או לנהל עסקאות, תקציבים וחשבונות חוזרים בכל פעם שאתה מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्र रीसेट. जब भी आप तैयार हों मैं लेनदेन, बजट और आवर्ती बिलों का विश्लेषण या प्रबंधन कर सकता हूं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno postavljanje sesije. Mogu analizirati ili upravljati transakcijama, proračunima i ponavljajućim računima kad god ste spremni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi disetel ulang. Saya dapat menganalisis atau mengelola transaksi, anggaran, dan tagihan berulang kapan pun Anda siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reimpostazione della sessione. Posso analizzare o gestire transazioni, budget e fatture ricorrenti ogni volta che sei pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションがリセットされました。準備ができたら、いつでもトランザクション、予算、定期的な請求書を分析または管理できます。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೆಷನ್ ರೀಸೆಟ್. ನೀವು ಸಿದ್ಧರಾಗಿರುವಾಗ ನಾನು ವಹಿವಾಟುಗಳು, ಬಜೆಟ್‌ಗಳು ಮತ್ತು ಮರುಕಳಿಸುವ ಬಿಲ್‌ಗಳನ್ನು ವಿಶ್ಲೇಷಿಸಬಹುದು ಅಥವಾ ನಿರ್ವಹಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 재설정. 귀하가 준비가 되면 언제든지 거래, 예산, 반복 청구서를 분석하거나 관리할 수 있습니다."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "സെഷൻ റീസെറ്റ്. നിങ്ങൾ തയ്യാറാകുമ്പോഴെല്ലാം എനിക്ക് ഇടപാടുകൾ, ബജറ്റുകൾ, ആവർത്തിച്ചുള്ള ബില്ലുകൾ എന്നിവ വിശകലനം ചെയ്യാനോ നിയന്ത്രിക്കാനോ കഴിയും."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्र रीसेट. जेव्हा तुम्ही तयार असाल तेव्हा मी व्यवहार, बजेट आणि आवर्ती बिलांचे विश्लेषण किंवा व्यवस्थापित करू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Set semula sesi. Saya boleh menganalisis atau mengurus urus niaga, belanjawan dan bil berulang apabila anda bersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Økt tilbakestilt. Jeg kan analysere eller administrere transaksjoner, budsjetter og gjentakende regninger når du er klar."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessie opnieuw instellen. Ik kan transacties, budgetten en terugkerende facturen analyseren of beheren wanneer u maar wilt."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅଧିବେଶନ ପୁନ et ସେଟ୍ | ଯେତେବେଳେ ଆପଣ ପ୍ରସ୍ତୁତ ଥିବେ ମୁଁ କାରବାର, ବଜେଟ୍ ଏବଂ ବାରମ୍ବାର ବିଲ୍ ବିଶ୍ଳେଷଣ କିମ୍ବା ପରିଚାଳନା କରିପାରିବି |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈਸ਼ਨ ਰੀਸੈੱਟ। ਜਦੋਂ ਵੀ ਤੁਸੀਂ ਤਿਆਰ ਹੋਵੋ ਤਾਂ ਮੈਂ ਲੈਣ-ਦੇਣ, ਬਜਟ ਅਤੇ ਆਵਰਤੀ ਬਿੱਲਾਂ ਦਾ ਵਿਸ਼ਲੇਸ਼ਣ ਜਾਂ ਪ੍ਰਬੰਧਨ ਕਰ ਸਕਦਾ/ਸਕਦੀ ਹਾਂ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinição de sessão. Posso analisar ou gerenciar transações, orçamentos e contas recorrentes sempre que você estiver pronto."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "அமர்வு மீட்டமைப்பு. நீங்கள் தயாராக இருக்கும்போதெல்லாம் பரிவர்த்தனைகள், வரவு செலவுகள் மற்றும் தொடர்ச்சியான பில்களை என்னால் பகுப்பாய்வு செய்யவோ நிர்வகிக்கவோ முடியும்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "సెషన్ రీసెట్. మీరు సిద్ధంగా ఉన్నప్పుడు నేను లావాదేవీలు, బడ్జెట్‌లు మరియు పునరావృత బిల్లులను విశ్లేషించగలను లేదా నిర్వహించగలను."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเซ็ตเซสชัน ฉันสามารถวิเคราะห์หรือจัดการธุรกรรม งบประมาณ และการเรียกเก็บเงินที่เกิดซ้ำได้ทุกเมื่อที่คุณพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum sıfırlandı. Hazır olduğunuzda işlemleri, bütçeleri ve yinelenen faturaları analiz edebilir veya yönetebilirim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скидання сеансу. Я можу аналізувати або керувати транзакціями, бюджетами та регулярними рахунками, коли ви будете готові."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "سیشن ری سیٹ۔ جب بھی آپ تیار ہوں میں لین دین، بجٹ اور اعادی بلوں کا تجزیہ یا ان کا نظم کر سکتا ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lại phiên. Tôi có thể phân tích hoặc quản lý các giao dịch, ngân sách và hóa đơn định kỳ bất cứ khi nào bạn sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话重置。只要您准备好，我就可以分析或管理交易、预算和经常性账单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會話重置。只要您準備好，我就可以分析或管理交易、預算和經常性帳單。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Økt tilbakestilt. Jeg kan analysere eller administrere transaksjoner, budsjetter og gjentakende regninger når du er klar."
          }
        }
      }
    },

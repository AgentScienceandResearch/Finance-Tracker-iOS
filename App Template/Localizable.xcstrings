        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses penuh, ditagih setiap bulan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso completo, fatturato ogni mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルアクセス。毎月請求されます。"

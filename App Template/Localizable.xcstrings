        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fonctionnalité, aucun frais jusqu'à la fin de votre essai."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી અજમાયશ સમાપ્ત થાય ત્યાં સુધી દરેક સુવિધા, શૂન્ય શુલ્ક."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",

    "Email already in use. Try signing in.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "البريد الإلكتروني قيد الاستخدام بالفعل. حاول تسجيل الدخول."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমেল ইতিমধ্যে ব্যবহার করা হচ্ছে. সাইন ইন করার চেষ্টা করুন।"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail wird bereits verwendet. Versuchen Sie, sich anzumelden."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Email already in use. Try signing in."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Email already in use. Try signing in."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Email already in use. Try signing in."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Email already in use. Try signing in."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Correo electrónico ya en uso. Intenta iniciar sesión."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail déjà utilisé. Essayez de vous connecter."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail déjà utilisé. Essayez de vous connecter."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ઇમેઇલ પહેલેથી ઉપયોગમાં છે. સાઇન ઇન કરવાનો પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דוא\"ל כבר בשימוש. נסה להיכנס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ईमेल पहले से ही उपयोग में है. साइन इन करने का प्रयास करें."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-pošta se već koristi. Pokušajte se prijaviti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email sudah digunakan. Coba masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail già in uso. Prova ad accedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電子メールはすでに使用されています。サインインしてみてください。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಮೇಲ್ ಈಗಾಗಲೇ ಬಳಕೆಯಲ್ಲಿದೆ. ಸೈನ್ ಇನ್ ಮಾಡಲು ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 사용 중인 이메일입니다. 로그인해 보세요."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇമെയിൽ ഇതിനകം ഉപയോഗത്തിലാണ്. സൈൻ ഇൻ ചെയ്യാൻ ശ്രമിക്കുക."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ईमेल आधीच वापरात आहे. साइन इन करण्याचा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mel sudah digunakan. Cuba log masuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-post er allerede i bruk. Prøv å logge på."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail is al in gebruik. Probeer in te loggen."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଇମେଲ ପୂର୍ବରୁ ବ୍ୟବହାରରେ ଅଛି | ସାଇନ୍ ଇନ୍ କରିବାକୁ ଚେଷ୍ଟା କରନ୍ତୁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਈਮੇਲ ਪਹਿਲਾਂ ਹੀ ਵਰਤੋਂ ਵਿੱਚ ਹੈ। ਸਾਈਨ ਇਨ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail já em uso. Tente fazer login."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "மின்னஞ்சல் ஏற்கனவே பயன்பாட்டில் உள்ளது. உள்நுழைய முயற்சிக்கவும்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇమెయిల్ ఇప్పటికే వాడుకలో ఉంది. సైన్ ఇన్ చేయడానికి ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมล์มีการใช้งานแล้ว ลองลงชื่อเข้าใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta zaten kullanılıyor. Oturum açmayı deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Електронна пошта вже використовується. Спробуйте ввійти."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "ای میل پہلے سے استعمال میں ہے۔ سائن ان کرنے کی کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email đã được sử dụng. Hãy thử đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电子邮件已被使用。尝试登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電子郵件已被使用。嘗試登入。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "E-post er allerede i bruk. Prøv å logge på."
          }
        }
      }
    },

            "value": "Un jour avant l'échéance de chaque facture"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jour avant l'échéance de chaque facture"
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક બિલ બાકી હોય તેના એક દિવસ પહેલા"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יום לפני כל תשלום"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक बिल देय होने से एक दिन पहले"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan prije dospijeća svakog računa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehari sebelum setiap tagihan jatuh tempo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno prima della scadenza di ogni fattura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各請求書の期限の前日"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಬಿಲ್ ಪಾವತಿಗೆ ಒಂದು ದಿನ ಮೊದಲು"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 청구서 마감일 하루 전"
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ബില്ലിനും ഒരു ദിവസം മുമ്പ്"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक बिल देय होण्याच्या एक दिवस आधी"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehari sebelum setiap bil perlu dibayar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En dag før hver regning forfaller"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dag voordat elke factuur moet worden betaald"

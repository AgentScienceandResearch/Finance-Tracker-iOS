          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n適用できませんでした:\n"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\nಅನ್ವಯಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ:\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n신청할 수 없음:\n"
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\nഅപേക്ഷിക്കാൻ കഴിഞ്ഞില്ല:\n"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\nअर्ज करू शकलो नाही:\n"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "\ntidak dapat memohon:\n"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "\nKunne ikke søke:\n"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "\nKan niet worden toegepast:\n"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\nପ୍ରୟୋଗ ହୋଇପାରିଲା ନାହିଁ:\n"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\nਲਾਗੂ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਿਆ:\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\nNão foi possível aplicar:\n"
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\nவிண்ணப்பிக்க முடியவில்லை:\n"
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\nదరఖాస్తు చేయడం సాధ్యపడలేదు:\n"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\nไม่สามารถสมัครได้:\n"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nUygulanamadı:\n"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\nНе вдалося застосувати:\n"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "\nدرخواست نہیں دی جا سکی:\n"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\nKhông thể áp dụng:\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n无法申请：\n"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n無法申請：\n"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "\nKunne ikke søke:\n"
          }
        }
      }

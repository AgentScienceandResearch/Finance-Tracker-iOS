            "value": "Subscribe to keep your finances on track."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe to keep your finances on track."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete para mantener tus finanzas al día."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnez-vous pour garder vos finances sur la bonne voie."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnez-vous pour garder vos finances sur la bonne voie."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી નાણાકીય બાબતોને ટ્રેક પર રાખવા માટે સબ્સ્ક્રાઇબ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הירשם כדי לשמור על הכספים שלך במסלול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने वित्त को ट्रैक पर रखने के लिए सदस्यता लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretplatite se kako biste održavali svoje financije na pravom putu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlanggananlah agar keuangan Anda tetap pada jalurnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iscriviti per tenere sotto controllo le tue finanze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読して、財政を順調に保ちましょう。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಹಣಕಾಸುಗಳನ್ನು ಟ್ರ್ಯಾಕ್‌ನಲ್ಲಿ ಇರಿಸಿಕೊಳ್ಳಲು ಚಂದಾದಾರರಾಗಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재정을 순조롭게 유지하려면 구독하세요."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സാമ്പത്തികം ട്രാക്കിൽ നിലനിർത്താൻ സബ്‌സ്‌ക്രൈബ് ചെയ്യുക."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची आर्थिक स्थिती ट्रॅकवर ठेवण्यासाठी सदस्यता घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Langgan untuk memastikan kewangan anda berada di landasan yang betul."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonner for å holde økonomien i orden."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonneer u om uw financiën op het goede spoor te houden."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ଆର୍ଥିକ ଟ୍ରାକ୍ ରଖିବାକୁ ସବସ୍କ୍ରାଇବ କର |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਵਿੱਤ ਨੂੰ ਟਰੈਕ 'ਤੇ ਰੱਖਣ ਲਈ ਗਾਹਕ ਬਣੋ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine para manter suas finanças sob controle."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நிதிகளை கண்காணிக்க குழுசேரவும்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఆర్థిక స్థితిని ట్రాక్‌లో ఉంచుకోవడానికి సభ్యత్వాన్ని పొందండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมัครสมาชิกเพื่อให้การเงินของคุณเป็นไปตามแผน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mali durumunuzu yolunda tutmak için abone olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підпишіться, щоб підтримувати свої фінанси в порядку."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے مالی معاملات کو ٹریک پر رکھنے کے لیے سبسکرائب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký để giữ tài chính của bạn đi đúng hướng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅以保持您的财务步入正轨。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱以保持您的財務步入正軌。"
          }
        },
        "no": {
          "stringUnit": {

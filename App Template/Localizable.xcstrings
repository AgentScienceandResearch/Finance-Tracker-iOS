        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा पहिला खर्च जोडण्यासाठी + वर टॅप करा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik + untuk menambah perbelanjaan pertama anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på + for å legge til din første utgift"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op + om uw eerste uitgave toe te voegen"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର ପ୍ରଥମ ଖର୍ଚ୍ଚ ଯୋଡିବାକୁ + ଟ୍ୟାପ୍ କରନ୍ତୁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣਾ ਪਹਿਲਾ ਖਰਚਾ ਜੋੜਨ ਲਈ + 'ਤੇ ਟੈਪ ਕਰੋ"

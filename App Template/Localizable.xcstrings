        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ବିଲ୍ ଦେବାର ଗୋଟିଏ ଦିନ ପୂର୍ବରୁ |"

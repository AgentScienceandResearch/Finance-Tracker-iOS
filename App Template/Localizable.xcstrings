          "stringUnit": {
            "state": "translated",
            "value": "Langgan setiap bulan untuk terus menjejaki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonner månedlig for å fortsette å spore."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonneer u maandelijks om te blijven volgen."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟ୍ରାକିଂ ରଖିବା ପାଇଁ ମାସିକ ସବସ୍କ୍ରାଇବ କରନ୍ତୁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟਰੈਕਿੰਗ ਰੱਖਣ ਲਈ ਮਹੀਨਾਵਾਰ ਗਾਹਕ ਬਣੋ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine mensalmente para acompanhar."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர்ந்து கண்காணிக்க மாதந்தோறும் குழுசேரவும்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రాక్ చేయడం కోసం నెలవారీ సభ్యత్వాన్ని పొందండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมัครสมาชิกรายเดือนเพื่อติดตาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takip etmeye devam etmek için aylık abone olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підпишіться щомісяця, щоб стежити."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "باخبر رہنے کے لیے ماہانہ سبسکرائب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký hàng tháng để theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月订阅以保持跟踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月訂閱以保持追蹤。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonner månedlig for å fortsette å spore."
          }
        }
      }
    },
    "Subscribe to keep your finances on track.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترك للحفاظ على اموالك على المسار الصحيح."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাক আপনার আর্থিক রাখা সদস্যতা."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnieren Sie, um Ihre Finanzen im Griff zu behalten."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe to keep your finances on track."
          }
        },
        "en-CA": {

        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "\nઅરજી કરી શકાઈ નથી:\n"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\nלא ניתן להחיל:\n"
          }
        },
        "hi": {
          "stringUnit": {

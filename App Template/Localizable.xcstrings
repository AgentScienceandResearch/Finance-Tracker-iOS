            "value": "Experience ultra-responsive performance with optimized rendering"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente un rendimiento ultrasensible con renderizado optimizado"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bénéficiez de performances ultra-réactives avec un rendu optimisé"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bénéficiez de performances ultra-réactives avec un rendu optimisé"
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ઑપ્ટિમાઇઝ રેન્ડરિંગ સાથે અલ્ટ્રા-રિસ્પોન્સિવ પ્રદર્શનનો અનુભવ કરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חווה ביצועים מגיבים במיוחד עם עיבוד אופטימלי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुकूलित रेंडरिंग के साथ अति-उत्तरदायी प्रदर्शन का अनुभव करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doživite ultra-odzivnu izvedbu s optimiziranim renderiranjem"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasakan kinerja ultra-responsif dengan rendering yang dioptimalkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperimenta prestazioni ultra reattive con rendering ottimizzato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最適化されたレンダリングによる超応答性の高いパフォーマンスを体験してください"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಪ್ಟಿಮೈಸ್ಡ್ ರೆಂಡರಿಂಗ್‌ನೊಂದಿಗೆ ಅಲ್ಟ್ರಾ-ರೆಸ್ಪಾನ್ಸಿವ್ ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಅನುಭವಿಸಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최적화된 렌더링으로 탁월한 응답 성능을 경험해 보세요."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒപ്റ്റിമൈസ് ചെയ്ത റെൻഡറിംഗ് ഉപയോഗിച്ച് അൾട്രാ റെസ്‌പോൺസീവ് പ്രകടനം അനുഭവിക്കുക"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑप्टिमाइझ रेंडरिंगसह अल्ट्रा-रिस्पॉन्सिव्ह कामगिरीचा अनुभव घ्या"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alami prestasi ultra responsif dengan pemaparan yang dioptimumkan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplev ultraresponsiv ytelse med optimert gjengivelse"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ervaar ultraresponsieve prestaties met geoptimaliseerde weergave"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅପ୍ଟିମାଇଜ୍ ରେଣ୍ଡରିଂ ସହିତ ଅଲ୍ଟ୍ରା-ପ୍ରତିକ୍ରିୟାଶୀଳ କାର୍ଯ୍ୟଦକ୍ଷତା ଅନୁଭବ କରନ୍ତୁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਨੁਕੂਲਿਤ ਰੈਂਡਰਿੰਗ ਦੇ ਨਾਲ ਅਤਿ-ਜਵਾਬਦੇਹ ਪ੍ਰਦਰਸ਼ਨ ਦਾ ਅਨੁਭਵ ਕਰੋ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente um desempenho ultra-responsivo com renderização otimizada"
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "உகந்த ரெண்டரிங் மூலம் அதி-பதிலளிக்கக்கூடிய செயல்திறனை அனுபவிக்கவும்"
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆప్టిమైజ్ చేసిన రెండరింగ్‌తో అల్ట్రా-రెస్పాన్సివ్ పనితీరును అనుభవించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัมผัสประสบการณ์ประสิทธิภาพที่ตอบสนองเป็นพิเศษด้วยการเรนเดอร์ที่ได้รับการปรับปรุง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimize edilmiş işlemeyle ultra duyarlı performansı deneyimleyin"
          }
        },

          "stringUnit": {
            "state": "translated",
            "value": "Ketuk + untuk menambahkan pengeluaran pertama Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca + per aggiungere la tua prima spesa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「+」をタップして最初の経費を追加します"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮೊದಲ ವೆಚ್ಚವನ್ನು ಸೇರಿಸಲು + ಟ್ಯಾಪ್ ಮಾಡಿ"

    "Cancel anytime in App Store Settings. Subscription auto-renews unless cancelled at least 24 hours before the end of the current period.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الإلغاء في أي وقت من خلال إعدادات App Store. يتم تجديد الاشتراك تلقائيًا ما لم يتم إلغاؤه قبل 24 ساعة على الأقل من نهاية الفترة الحالية."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store সেটিংস থেকে যেকোনো সময় বাতিল করুন। বর্তমান মেয়াদ শেষ হওয়ার কমপক্ষে 24 ঘন্টা আগে বাতিল না হলে সদস্যতা স্বয়ংক্রিয়ভাবে পুনর্নবীকরণ হয়।"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können jederzeit in den App Store-Einstellungen kündigen. Das Abonnement verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor dem Ende des aktuellen Zeitraums gekündigt wird."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel anytime in App Store Settings. Subscription auto-renews unless cancelled at least 24 hours before the end of the current period."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel anytime in App Store Settings. Subscription auto-renews unless cancelled at least 24 hours before the end of the current period."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel anytime in App Store Settings. Subscription auto-renews unless cancelled at least 24 hours before the end of the current period."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel anytime in App Store Settings. Subscription auto-renews unless cancelled at least 24 hours before the end of the current period."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele en cualquier momento en App Store Configuración. La suscripción se renueva automáticamente a menos que se cancele al menos 24 horas antes del final del período actual."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez à tout moment dans les paramètres App Store. L'abonnement se renouvelle automatiquement sauf annulation au moins 24 heures avant la fin de la période en cours."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez à tout moment dans les paramètres App Store. L'abonnement se renouvelle automatiquement sauf annulation au moins 24 heures avant la fin de la période en cours."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store સેટિંગ્સમાં ગમે ત્યારે રદ કરો. વર્તમાન સમયગાળાની સમાપ્તિના ઓછામાં ઓછા 24 કલાક પહેલાં રદ ન થાય તો સબ્સ્ક્રિપ્શન ઑટો-રિન્યૂ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטל בכל עת בהגדרות App Store. המנוי מתחדש אוטומטית, אלא אם כן בוטל לפחות 24 שעות לפני תום התקופה הנוכחית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store सेटिंग्स में किसी भी समय रद्द करें। वर्तमान अवधि के अंत से कम से कम 24 घंटे पहले रद्द किए जाने तक सदस्यता स्वतः नवीनीकृत हो जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otkažite bilo kada u postavkama App Store. Pretplata se automatski obnavlja osim ako se ne otkaže najmanje 24 sata prije kraja tekućeg razdoblja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan kapan saja di Pengaturan App Store. Langganan diperpanjang secara otomatis kecuali dibatalkan setidaknya 24 jam sebelum akhir periode berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla in qualsiasi momento nelle Impostazioni di App Store. L'abbonamento si rinnova automaticamente a meno che non venga annullato almeno 24 ore prima della fine del periodo corrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 設定でいつでもキャンセルできます。現在の期間が終了する少なくとも 24 時間前にキャンセルしない限り、サブスクリプションは自動更新されます。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ರದ್ದುಮಾಡಿ. ಪ್ರಸ್ತುತ ಅವಧಿ ಮುಗಿಯುವ ಕನಿಷ್ಠ 24 ಗಂಟೆಗಳ ಮೊದಲು ರದ್ದುಗೊಳಿಸದ ಹೊರತು ಚಂದಾದಾರಿಕೆ ಸ್ವಯಂ-ನವೀಕರಣಗೊಳ್ಳುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 설정에서 언제든지 취소하세요. 현재 기간이 종료되기 최소 24시간 전에 취소하지 않으면 구독이 자동 갱신됩니다."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ക്രമീകരണങ്ങളിൽ എപ്പോൾ വേണമെങ്കിലും റദ്ദാക്കുക. നിലവിലെ കാലയളവ് അവസാനിക്കുന്നതിന് 24 മണിക്കൂർ മുമ്പെങ്കിലും റദ്ദാക്കിയില്ലെങ്കിൽ സബ്‌സ്‌ക്രിപ്‌ഷൻ സ്വയമേവ പുതുക്കും."
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store सेटिंग्जमध्ये कधीही रद्द करा. वर्तमान कालावधी संपण्याच्या किमान 24 तास आधी रद्द न केल्यास सदस्यता स्वयं-नूतनीकरण होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan bila-bila masa dalam Tetapan App Store. Langganan diperbaharui secara automatik melainkan dibatalkan sekurang-kurangnya 24 jam sebelum tamat tempoh semasa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt når som helst i App Store-innstillingene. Abonnementet fornyes automatisk med mindre det kanselleres minst 24 timer før slutten av gjeldende periode."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt op elk gewenst moment opzeggen via de App Store Instellingen. Het abonnement wordt automatisch verlengd, tenzij het ten minste 24 uur voor het einde van de huidige periode wordt opgezegd."
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ସେଟିଂସମୂହରେ ଯେକ time ଣସି ସମୟରେ ବାତିଲ୍ କରନ୍ତୁ | ସାମ୍ପ୍ରତିକ ଅବଧି ଶେଷ ହେବାର ଅତି କମରେ 24 ଘଣ୍ଟା ପୂର୍ବରୁ ବାତିଲ୍ ନହେବା ପର୍ଯ୍ୟନ୍ତ ସଦସ୍ୟତା ସ୍ auto ତ - ନବୀକରଣ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਕਿਸੇ ਵੀ ਸਮੇਂ ਰੱਦ ਕਰੋ। ਗਾਹਕੀ ਆਟੋ-ਰੀਨਿਊ ਹੁੰਦੀ ਹੈ ਜਦੋਂ ਤੱਕ ਮੌਜੂਦਾ ਮਿਆਦ ਦੇ ਅੰਤ ਤੋਂ ਘੱਟੋ-ਘੱਟ 24 ਘੰਟੇ ਪਹਿਲਾਂ ਰੱਦ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele a qualquer momento nas configurações de App Store. A assinatura é renovada automaticamente, a menos que seja cancelada pelo menos 24 horas antes do final do período atual."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store அமைப்புகளில் எப்போது வேண்டுமானாலும் ரத்துசெய்யலாம். தற்போதைய காலகட்டம் முடிவதற்குக் குறைந்தது 24 மணிநேரத்திற்கு முன்பு ரத்துசெய்யப்படாவிட்டால் சந்தா தானாகவே புதுப்பிக்கப்படும்."
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store సెట్టింగ్‌లలో ఎప్పుడైనా రద్దు చేయండి. ప్రస్తుత వ్యవధి ముగియడానికి కనీసం 24 గంటల ముందు రద్దు చేయకపోతే సభ్యత్వం స్వయంచాలకంగా పునరుద్ధరించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกได้ตลอดเวลาในการตั้งค่า App Store การสมัครสมาชิกจะต่ออายุอัตโนมัติเว้นแต่จะยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดช่วงเวลาปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Ayarlar'dan istediğiniz zaman iptal edebilirsiniz. Abonelik, mevcut dönemin bitiminden en az 24 saat önce iptal edilmediği sürece otomatik olarak yenilenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати будь-коли в налаштуваннях App Store. Підписка автоматично поновлюється, якщо її не скасовано принаймні за 24 години до закінчення поточного періоду."
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ترتیبات میں کسی بھی وقت منسوخ کریں۔ سبسکرپشن خودکار تجدید ہو جاتی ہے جب تک کہ موجودہ مدت کے اختتام سے کم از کم 24 گھنٹے پہلے منسوخ کر دیا جائے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy bất kỳ lúc nào trong App Store Cài đặt. Đăng ký tự động gia hạn trừ khi bị hủy ít nhất 24 giờ trước khi kết thúc giai đoạn hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时在 App Store 设置中取消。除非在当前订阅期结束前至少 24 小时取消，否则订阅将自动续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時在 App Store 設定中取消。除非在當前訂閱期結束前至少 24 小時取消，否則訂閱將自動續訂。"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt når som helst i App Store-innstillingene. Abonnementet fornyes automatisk med mindre det kanselleres minst 24 timer før slutten av gjeldende periode."
          }
        }
      }
    },

        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਇਸ ਮਹੀਨੇ %2$@ ਨੂੰ %1$@ ਖਰਚ ਕੀਤਾ, ਜੋ ਕੁੱਲ ਖਰਚਿਆਂ ਦਾ %3$lld%% ਹੈ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você gastou %1$@ em %2$@ este mês, o que representa %3$lld%% do gasto total."
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மாதம் %2$@ இல் %1$@ செலவிட்டீர்கள், இது மொத்த செலவில் %3$lld%% ஆகும்."

        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 나은 조명이나 더 평평한 문서에서 다시 스캔해 보십시오."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "മികച്ച ലൈറ്റിംഗോ മുഖസ്തുതിയുള്ള പ്രമാണമോ ഉപയോഗിച്ച് വീണ്ടും സ്കാൻ ചെയ്യാൻ ശ്രമിക്കുക."

    "Experience ultra-responsive performance with optimized rendering": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "استمتع بأداء فائق الاستجابة مع العرض الأمثل"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "অপ্টিমাইজড রেন্ডারিংয়ের সাথে অতি-প্রতিক্রিয়াশীল পারফরম্যান্সের অভিজ্ঞতা নিন"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Erleben Sie extrem reaktionsschnelle Leistung mit optimiertem Rendering"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Experience ultra-responsive performance with optimized rendering"
          }
        },
        "en-CA": {

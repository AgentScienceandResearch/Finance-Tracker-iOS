        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณใช้จ่าย %1$@ กับ %2$@ ในเดือนนี้ ซึ่งเท่ากับ %3$lld%% ของการใช้จ่ายทั้งหมด"

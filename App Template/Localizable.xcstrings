    "Nothing changes without your approval": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء يتغير دون موافقتك"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অনুমোদন ছাড়া কিছুই পরিবর্তন"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Ihre Zustimmung ändert sich nichts"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes without your approval"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes without your approval"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes without your approval"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes without your approval"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada cambia sin tu aprobación"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne change sans votre approbation"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne change sans votre approbation"
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી મંજૂરી વિના કંઈપણ બદલાતું નથી"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא משתנה ללא אישורך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी मंजूरी के बिना कुछ भी नहीं बदलता"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne mijenja bez vašeg odobrenja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang berubah tanpa persetujuan Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente cambia senza la tua approvazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの承認がなければ何も変わりません"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಅನುಮೋದನೆಯಿಲ್ಲದೆ ಏನೂ ಬದಲಾಗುವುದಿಲ್ಲ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 승인 없이는 아무것도 변하지 않습니다"
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അംഗീകാരമില്ലാതെ ഒന്നും മാറില്ല"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या संमतीशिवाय काहीही बदलत नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa perubahan tanpa kelulusan anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting endres uten din godkjenning"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Er verandert niets zonder uw goedkeuring"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଅନୁମୋଦନ ବିନା କିଛି ପରିବର୍ତ୍ତନ ହୁଏ ନାହିଁ |"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਮਨਜ਼ੂਰੀ ਤੋਂ ਬਿਨਾਂ ਕੁਝ ਨਹੀਂ ਬਦਲਦਾ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada muda sem a sua aprovação"
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஒப்புதல் இல்லாமல் எதுவும் மாறாது"
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఆమోదం లేకుండా ఏదీ మారదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการเปลี่ยนแปลงใด ๆ หากไม่ได้รับการอนุมัติจากคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayınız olmadan hiçbir şey değişmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо не змінюється без вашого схвалення"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی منظوری کے بغیر کچھ نہیں بدلتا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì thay đổi nếu không có sự chấp thuận của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经您的批准，任何事情都不会改变"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未經您的批准，任何事情都不會改變"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting endres uten din godkjenning"
          }
        }
      }

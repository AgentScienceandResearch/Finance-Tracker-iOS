    "Ask me anything about your spending, budgets, or savings goals. I'm here to help! ✨": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اسألني عن أي شيء عن أهدافك المتعلقة بالإنفاق أو الميزانيات أو الادخار. أنا هنا للمساعدة! ✨"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার খরচ, বাজেট, বা সঞ্চয় লক্ষ্য সম্পর্কে আমাকে কিছু জিজ্ঞাসা করুন. আমি সাহায্য করতে এখানে আছি! ✨"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen Sie mich nach Ihren Ausgaben, Budgets oder Sparzielen. Ich bin hier, um zu helfen! ✨"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me anything about your spending, budgets, or savings goals. I'm here to help! ✨"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me anything about your spending, budgets, or savings goals. I'm here to help! ✨"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me anything about your spending, budgets, or savings goals. I'm here to help! ✨"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me anything about your spending, budgets, or savings goals. I'm here to help! ✨"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntame cualquier cosa sobre tus gastos, presupuestos u objetivos de ahorro. ¡Estoy aquí para ayudar! ✨"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-moi n'importe quoi sur vos dépenses, vos budgets ou vos objectifs d'épargne. Je suis là pour vous aider ! ✨"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-moi n'importe quoi sur vos dépenses, vos budgets ou vos objectifs d'épargne. Je suis là pour vous aider ! ✨"
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ખર્ચ, બજેટ અથવા બચત લક્ષ્યો વિશે મને કંઈપણ પૂછો. હું મદદ કરવા માટે અહીં છું! ✨"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שאל אותי כל דבר לגבי ההוצאות, התקציבים או יעדי החיסכון שלך. אני כאן כדי לעזור! ✨"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुझसे अपने खर्च, बजट या बचत लक्ष्य के बारे में कुछ भी पूछें। मैं मदद के लिए यहाँ हूँ! ✨"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitajte me bilo što o vašoj potrošnji, proračunima ili ciljevima štednje. Ovdje sam da pomognem! ✨"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanyakan kepada saya apa pun tentang pengeluaran, anggaran, atau tujuan tabungan Anda. Saya di sini untuk membantu! ✨"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedimi qualsiasi cosa sulle tue spese, budget o obiettivi di risparmio. Sono qui per aiutarti! ✨"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの支出、予算、貯蓄目標について何でも聞いてください。私は助けに来ました！ ✨"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಖರ್ಚು, ಬಜೆಟ್‌ಗಳು ಅಥವಾ ಉಳಿತಾಯ ಗುರಿಗಳ ಬಗ್ಗೆ ನನ್ನನ್ನು ಕೇಳಿ. ನಾನು ಸಹಾಯ ಮಾಡಲು ಇಲ್ಲಿದ್ದೇನೆ! ✨"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출, 예산, 저축 목표에 대해 무엇이든 물어보세요. 나는 도와주러 왔습니다! ✨"
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ചെലവുകൾ, ബജറ്റുകൾ, അല്ലെങ്കിൽ സേവിംഗ്സ് ലക്ഷ്യങ്ങൾ എന്നിവയെക്കുറിച്ച് എന്നോട് എന്തെങ്കിലും ചോദിക്കുക. സഹായിക്കാൻ ഞാൻ ഇവിടെയുണ്ട്! ✨"
          }
        },
        "mr-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा खर्च, बजेट किंवा बचत उद्दिष्टांबद्दल मला काहीही विचारा. मी मदत करण्यासाठी येथे आहे! ✨"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanya saya apa-apa tentang perbelanjaan, belanjawan atau matlamat simpanan anda. Saya di sini untuk membantu! ✨"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør meg hva som helst om dine utgifter, budsjetter eller sparemål. Jeg er her for å hjelpe! ✨"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag me alles over uw uitgaven, budgetten of besparingsdoelen. Ik ben hier om te helpen! ✨"
          }
        },
        "or-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ଖର୍ଚ୍ଚ, ବଜେଟ୍, କିମ୍ବା ସଞ୍ଚୟ ଲକ୍ଷ୍ୟ ବିଷୟରେ ମୋତେ କିଛି ପଚାର | ମୁଁ ସାହାଯ୍ୟ କରିବାକୁ ଆସିଛି! ✨"
          }
        },
        "pa-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਨੂੰ ਆਪਣੇ ਖਰਚਿਆਂ, ਬਜਟਾਂ, ਜਾਂ ਬੱਚਤ ਟੀਚਿਆਂ ਬਾਰੇ ਕੁਝ ਵੀ ਪੁੱਛੋ। ਮੈਂ ਮਦਦ ਕਰਨ ਲਈ ਇੱਥੇ ਹਾਂ! ✨"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte-me qualquer coisa sobre seus gastos, orçamentos ou metas de economia. Estou aqui para ajudar! ✨"
          }
        },
        "ta-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் செலவுகள், வரவு செலவுகள் அல்லது சேமிப்பு இலக்குகள் பற்றி என்னிடம் எதையும் கேளுங்கள். நான் உதவ இங்கே இருக்கிறேன்! ✨"
          }
        },
        "te-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఖర్చులు, బడ్జెట్‌లు లేదా పొదుపు లక్ష్యాల గురించి ఏదైనా నన్ను అడగండి. నేను సహాయం చేయడానికి ఇక్కడ ఉన్నాను! ✨"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามฉันเกี่ยวกับการใช้จ่าย งบประมาณ หรือเป้าหมายการออมของคุณ ฉันมาที่นี่เพื่อช่วย! ✨"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcamalarınız, bütçeleriniz veya tasarruf hedefleriniz hakkında bana her şeyi sorun. Yardım etmek için buradayım! ✨"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте мене про свої витрати, бюджет або цілі заощаджень. Я тут, щоб допомогти! ✨"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "مجھ سے اپنے اخراجات، بجٹ، یا بچت کے اہداف کے بارے میں کچھ پوچھیں۔ میں مدد کرنے کے لیے حاضر ہوں! ✨"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy hỏi tôi bất cứ điều gì về chi tiêu, ngân sách hoặc mục tiêu tiết kiệm của bạn. Tôi ở đây để giúp đỡ! ✨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向我询问有关您的支出、预算或储蓄目标的任何信息。我是来帮忙的！ ✨"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向我詢問有關您的支出、預算或儲蓄目標的任何資訊。我是來幫忙的！ ✨"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør meg hva som helst om dine utgifter, budsjetter eller sparemål. Jeg er her for å hjelpe! ✨"
          }
        }
      }
    },
    "Authentication failed. Please try again.": {
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت المصادقة. يرجى المحاولة مرة أخرى."
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রমাণীকরণ ব্যর্থ হয়েছে৷ আবার চেষ্টা করুন."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Authentifizierung ist fehlgeschlagen. Bitte versuchen Sie es erneut."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed. Please try again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed. Please try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed. Please try again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed. Please try again."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La autenticación falló. Por favor inténtalo de nuevo."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification a échoué. Veuillez réessayer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification a échoué. Veuillez réessayer."
          }
        },
        "gu-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રમાણીકરણ નિષ્ફળ થયું. કૃપા કરીને ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האימות נכשל. אנא נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणीकरण विफल रहा. कृपया पुन: प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentifikacija nije uspjela. Molimo pokušajte ponovo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otentikasi gagal. Silakan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticazione non riuscita. Per favore riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証に失敗しました。もう一度試してください。"
          }
        },
        "kn-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "ದೃಢೀಕರಣ ವಿಫಲವಾಗಿದೆ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증에 실패했습니다. 다시 시도해 주세요."
          }
        },
        "ml-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രാമാണീകരണം പരാജയപ്പെട്ടു. ദയവായി വീണ്ടും ശ്രമിക്കുക."
